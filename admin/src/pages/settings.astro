---
import AdminShell from '../components/templates/AdminShell.astro';
import Card from '../components/atoms/Card.astro';
import Button from '../components/atoms/Button.astro';
import Field from '../components/molecules/Field.astro';

const title = 'サイト設定 | Wild Media CMS';
---
<AdminShell title={title} heading="サイト設定">
  <Card class="p-6">
    <form id="settings-form" class="space-y-4">
      <Field id="interval" label="通常記事の投稿間隔(日)" type="number" min="0" step="1" required />
      <Field
        id="featured"
        label="Featured 表示件数(直近の依頼記事、上限)"
        type="number"
        min="0"
        step="1"
        required
      />
      <Field
        id="featured-window"
        label="Featured 表示期間(公開から何日以内の依頼記事を対象にするか)"
        type="number"
        min="0"
        step="1"
        required
      />
      <Field id="page-size" label="一覧1ページあたりの記事数" type="number" min="1" step="1" required />
      <div class="flex items-center gap-4 pt-2">
        <Button type="submit">保存</Button>
        <p id="message" role="alert" class="text-sm text-muted-foreground"></p>
      </div>
    </form>
  </Card>
  <p class="mt-4 text-sm text-muted-foreground">変更は次回の公開サイト再ビルドから反映されます。</p>

  <script>
      import { supabaseBrowser } from '../lib/supabase-browser';
      import { redirectTo } from '../lib/auth';
      import { fetchSettings, updateSettings } from '../lib/admin';
      import { initShellChrome } from '../lib/shell';

      const { data: { session } } = await supabaseBrowser.auth.getSession();
      if (!session) {
        redirectTo('/login');
      } else {
        const { role, roleLookupFailed } = await initShellChrome(supabaseBrowser);
        if (roleLookupFailed) {
        // リダイレクトループを避けるため、ここではリダイレクトしない。
        document.getElementById('message')!.textContent =
          '権限の確認に失敗しました。ページを再読み込みしてください。';
      } else if (role !== 'admin') {
        // UX のためのリダイレクト。実際の防壁は RLS/トリガー。
        redirectTo('/dashboard');
      } else {
        const messageEl = document.getElementById('message')!;
        const intervalEl = document.getElementById('interval') as HTMLInputElement;
        const featuredEl = document.getElementById('featured') as HTMLInputElement;
        const featuredWindowEl = document.getElementById('featured-window') as HTMLInputElement;
        const pageSizeEl = document.getElementById('page-size') as HTMLInputElement;

        try {
          const s = await fetchSettings(supabaseBrowser);
          intervalEl.value = String(s.postIntervalDays);
          featuredEl.value = String(s.featuredCount);
          featuredWindowEl.value = String(s.featuredWindowDays);
          pageSizeEl.value = String(s.pageSize);
        } catch (err) {
          messageEl.textContent = '設定の読み込みに失敗しました。';
          console.error(err);
        }

        const settingsForm = document.getElementById('settings-form') as HTMLFormElement;
        const saveBtn = settingsForm.querySelector('button[type="submit"]') as HTMLButtonElement;
        let saveInFlight = false;

        settingsForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (saveInFlight) return;
          messageEl.textContent = '';
          // Number('') は 0 になってしまうため、空欄は明示的に弾く(投稿間隔0は間隔制限の無効化を意味する)。
          if (
            intervalEl.value.trim() === '' ||
            featuredEl.value.trim() === '' ||
            featuredWindowEl.value.trim() === '' ||
            pageSizeEl.value.trim() === ''
          ) {
            messageEl.textContent = '値を入力してください。';
            return;
          }
          saveInFlight = true;
          saveBtn.disabled = true;
          try {
            try {
              await updateSettings(supabaseBrowser, {
                postIntervalDays: Number(intervalEl.value),
                featuredCount: Number(featuredEl.value),
                featuredWindowDays: Number(featuredWindowEl.value),
                pageSize: Number(pageSizeEl.value),
              });
            } catch (err) {
              messageEl.textContent = '保存に失敗しました。入力値を確認してください。';
              console.error(err);
              return;
            }
            messageEl.textContent = '保存しました。';
          } finally {
            saveInFlight = false;
            saveBtn.disabled = false;
          }
        });
      }
      }
    </script>
</AdminShell>
