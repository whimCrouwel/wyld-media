---
import AdminLayout from '../layouts/AdminLayout.astro';
import Button from '../components/atoms/Button.astro';
import Avatar from '../components/atoms/Avatar.astro';

const title = 'ダッシュボード | Wild Media CMS';
const navLink = 'text-muted-foreground transition-colors hover:text-foreground';
---
<AdminLayout title={title}>
  <header class="border-b bg-card">
    <nav class="mx-auto flex h-14 max-w-3xl items-center justify-between px-4 text-sm">
      <div class="flex items-center gap-4">
        <a href="/dashboard" class="font-semibold text-foreground">Wild Media CMS</a>
        <a href="/dashboard" class={navLink}>ダッシュボード</a>
        <span id="admin-nav" hidden>
          <a href="/users" class={`mr-4 ${navLink}`}>ユーザー管理</a>
          <a href="/commissions" class={`mr-4 ${navLink}`}>依頼トークン管理</a>
          <a href="/settings" class={navLink}>サイト設定</a>
        </span>
        <span id="provider-nav" hidden>
          <a href="/commission" class={navLink}>ライターに依頼する</a>
        </span>
      </div>
      <div class="flex items-center gap-3">
        <a id="profile-nav" href="/profile" class={`flex items-center gap-2 ${navLink}`} hidden>
          <Avatar id="profile-nav-avatar" size={28} />
          <span id="profile-nav-name"></span>
        </a>
        <Button id="logout" type="button" variant="outline" size="sm">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="16 17 21 12 16 7" />
            <line x1="21" y1="12" x2="9" y2="12" />
          </svg>
          ログアウト
        </Button>
      </div>
    </nav>
  </header>
  <main class="mx-auto max-w-3xl px-4 py-8">
    <div class="mb-6 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <Avatar id="articles-heading-avatar" size={32} hidden />
        <h1 id="articles-heading" class="text-2xl font-semibold tracking-tight">自分の記事</h1>
      </div>
      <a
        href="/articles/new"
        class="inline-flex h-10 items-center justify-center gap-2 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
        >＋ 新しい記事を作成</a
      >
    </div>
    <p id="article-list-message" role="alert" class="mb-3 text-sm text-destructive"></p>
    <ul id="article-list" class="article-list"><li>読み込み中…</li></ul>
  </main>

  <script>
      import { supabaseBrowser } from '../lib/supabase-browser';
      import { redirectTo } from '../lib/auth';
      import { fetchMyArticles } from '../lib/dashboard';
      import { fetchMyRole, fetchMyProfile } from '../lib/admin';
      import { toAvatarViewModel, applyAvatar } from '../lib/avatar';
      import { deleteArticle } from '../lib/articles';
      import { initConfirmDialog } from '../lib/confirm-dialog';

      // 静的な SVG 定数のみ(ユーザーデータは含まない)。innerHTML で使って良い。
      const EDIT_ICON_SVG =
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>';
      const DELETE_ICON_SVG =
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6" /><path d="M14 11v6" /><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /></svg>';

      // 認証ガード
      const { data: { session } } = await supabaseBrowser.auth.getSession();
      if (!session) {
        redirectTo('/login');
      } else {
        document.getElementById('logout')!.addEventListener('click', async () => {
          await supabaseBrowser.auth.signOut();
          redirectTo('/login');
        });

        // admin にだけ管理ナビを見せる(出し分けは UX。防壁は RLS/トリガー)
        // fetchMyRole が失敗しても記事一覧の表示は妨げない(管理ナビが出ないだけにする)
        try {
          const role = await fetchMyRole(supabaseBrowser);
          if (role === 'admin') {
            document.getElementById('admin-nav')!.hidden = false;
          } else if (role === 'provider') {
            document.getElementById('provider-nav')!.hidden = false;
          }
        } catch (err) {
          console.error(err);
        }

        // ナビ・見出しのアバター/名前(失敗しても記事一覧の表示は妨げない)
        try {
          const profile = await fetchMyProfile(supabaseBrowser);
          if (profile) {
            const vm = toAvatarViewModel(profile.name, profile.avatarUrl);

            applyAvatar(document.getElementById('profile-nav-avatar')!, vm);
            document.getElementById('profile-nav-name')!.textContent = profile.name;
            document.getElementById('profile-nav')!.hidden = false;

            const headingAvatarEl = document.getElementById('articles-heading-avatar')!;
            applyAvatar(headingAvatarEl, vm);
            headingAvatarEl.hidden = false;
            document.getElementById('articles-heading')!.textContent = `${profile.name}さんの記事`;
          }
        } catch (err) {
          console.error(err);
        }

        const confirmDialog = initConfirmDialog(
          document.getElementById('confirm-dialog') as HTMLDialogElement,
        );

        const listEl = document.getElementById('article-list')!;
        const listMessageEl = document.getElementById('article-list-message')!;
        try {
          const articles = await fetchMyArticles(supabaseBrowser);
          if (articles.length === 0) {
            listEl.innerHTML = '<li>まだ記事がありません。</li>';
          } else {
            listEl.innerHTML = '';
            for (const a of articles) {
              const li = document.createElement('li');

              const info = document.createElement('div');
              info.className = 'article-info';

              // テキストは textContent で安全に入れる
              const titleEl = document.createElement('span');
              titleEl.className = 'article-title';
              titleEl.textContent = a.title;

              const meta = document.createElement('div');
              meta.className = 'article-meta';

              const statusBadge = document.createElement('span');
              statusBadge.className = `article-badge ${
                a.status === 'draft' ? 'article-badge--draft' : 'article-badge--published'
              }`;
              statusBadge.textContent = a.status === 'draft' ? '下書き' : '公開';
              meta.appendChild(statusBadge);

              if (a.isCommissioned) {
                const commissionedBadge = document.createElement('span');
                commissionedBadge.className = 'article-badge article-badge--commissioned';
                commissionedBadge.textContent = '依頼記事';
                meta.appendChild(commissionedBadge);
              }

              if (a.publishedAt) {
                const dateEl = document.createElement('span');
                dateEl.textContent = new Date(a.publishedAt).toLocaleDateString('ja-JP');
                meta.appendChild(dateEl);
              }

              info.appendChild(titleEl);
              info.appendChild(meta);

              const actions = document.createElement('div');
              actions.className = 'article-actions';

              const edit = document.createElement('a');
              edit.href = `/articles/edit?id=${a.id}`;
              edit.className = 'article-action';
              edit.innerHTML = EDIT_ICON_SVG;
              edit.append('編集');

              const del = document.createElement('button');
              del.type = 'button';
              del.className = 'article-action article-action--delete';
              del.innerHTML = DELETE_ICON_SVG;
              del.append('削除');
              del.addEventListener('click', async () => {
                listMessageEl.textContent = '';
                const ok = await confirmDialog.confirm({
                  title: '記事を削除しますか?',
                  body: `「${a.title}」を削除します。この操作は取り消せません。`,
                  confirmLabel: '削除する',
                });
                if (!ok) return;
                try {
                  await deleteArticle(supabaseBrowser, a.id);
                  li.remove();
                } catch (err) {
                  listMessageEl.textContent = '削除に失敗しました。時間をおいて再度お試しください。';
                  console.error(err);
                }
              });
              actions.appendChild(edit);
              actions.appendChild(del);
              li.appendChild(info);
              li.appendChild(actions);
              listEl.appendChild(li);
            }
          }
        } catch (err) {
          listEl.innerHTML = '<li>読み込みに失敗しました。</li>';
          console.error(err);
        }
      }
    </script>
</AdminLayout>
