---
import AdminLayout from '../layouts/AdminLayout.astro';

const title = 'Wild Media CMS';
---
<AdminLayout title={title}>
  <main class="flex min-h-screen items-center justify-center px-4">
    <p class="text-sm text-muted-foreground">読み込み中…</p>
  </main>
  <script>
      import { supabaseBrowser, initialAuthHash } from '../lib/supabase-browser';
      import { redirectTo, resolveRootRedirect } from '../lib/auth';
      const { data: { session } } = await supabaseBrowser.auth.getSession();
      redirectTo(resolveRootRedirect(initialAuthHash, Boolean(session)));
    </script>
</AdminLayout>
