---
import AdminLayout from '../layouts/AdminLayout.astro';
import Card from '../components/atoms/Card.astro';
import Button from '../components/atoms/Button.astro';
import Field from '../components/molecules/Field.astro';

const title = 'パスワード設定 | Wild Media CMS';
---
<AdminLayout title={title}>
  <main class="flex min-h-screen items-center justify-center px-4">
    <Card class="w-full max-w-sm p-6">
      <h1 class="mb-2 text-2xl font-semibold tracking-tight">パスワードの設定</h1>
      <p class="mb-6 text-sm text-muted-foreground">メールのリンクから続けてパスワードを設定してください。</p>
      <form id="pw-form" class="space-y-4">
        <Field id="password" label="新しいパスワード(8文字以上)" type="password" minlength="8" required />
        <Button type="submit" id="submit-btn" class="w-full">設定する</Button>
      </form>
      <p id="message" role="alert" class="mt-4 text-sm text-destructive"></p>
    </Card>
  </main>

  <script>
      import { supabaseBrowser } from '../lib/supabase-browser';
      import { redirectTo, translateAuthError, getRecoveryTokenHash, getAuthErrorMessageFromHash } from '../lib/auth';

      const form = document.getElementById('pw-form') as HTMLFormElement;
      const messageEl = document.getElementById('message')!;

      // 再設定メールは ?token_hash=...&type=recovery でこのページに直接届く。
      // メールスキャナがリンクを開いてもトークンは消費されず、フォーム送信時に
      // verifyOtp で初めて消費する(Gmail のプリフェッチでリンクが死ぬ問題の対策)。
      const tokenHash = getRecoveryTokenHash(window.location.search);

      // 招待リンク(旧フロー)はリダイレクトの hash でセッションが確立される。
      const { data: { session } } = await supabaseBrowser.auth.getSession();
      const hashError = getAuthErrorMessageFromHash(window.location.hash);
      if (hashError) {
        messageEl.textContent = hashError;
        (document.getElementById('submit-btn') as HTMLButtonElement).disabled = true;
      } else if (!session && !tokenHash) {
        messageEl.textContent = '有効なリンクが必要です。招待または再設定のメールのリンクから開いてください。';
        (document.getElementById('submit-btn') as HTMLButtonElement).disabled = true;
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        messageEl.textContent = '';
        const password = (document.getElementById('password') as HTMLInputElement).value;
        if (password.length < 8) { messageEl.textContent = 'パスワードは8文字以上にしてください'; return; }

        if (tokenHash && !session) {
          const { error: verifyError } = await supabaseBrowser.auth.verifyOtp({
            type: 'recovery',
            token_hash: tokenHash,
          });
          if (verifyError) {
            messageEl.textContent = 'リンクの有効期限が切れているか、既に使用されています。ログイン画面から再設定メールをもう一度請求してください。';
            console.error(verifyError);
            return;
          }
        }

        const { error } = await supabaseBrowser.auth.updateUser({ password });
        if (error) { messageEl.textContent = translateAuthError(error); console.error(error); return; }
        redirectTo('/dashboard');
      });
    </script>
</AdminLayout>
