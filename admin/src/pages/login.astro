---
import AdminLayout from '../layouts/AdminLayout.astro';
import Card from '../components/atoms/Card.astro';
import Button from '../components/atoms/Button.astro';
import Field from '../components/molecules/Field.astro';

const title = 'ログイン | Wild Media CMS';
---
<AdminLayout title={title}>
  <main class="flex min-h-screen items-center justify-center px-4">
    <Card class="w-full max-w-sm p-6">
      <h1 class="mb-6 text-2xl font-semibold tracking-tight">ログイン</h1>
      <form id="login-form" class="space-y-4">
        <Field id="email" label="メールアドレス" type="email" required />
        <Field id="password" label="パスワード" type="password" required />
        <Button type="submit" class="w-full">ログイン</Button>
      </form>
      <button
        type="button"
        id="forgot-password"
        class="mt-3 text-sm text-muted-foreground underline-offset-2 hover:text-foreground hover:underline"
        >パスワードをお忘れですか?</button
      >
      <p id="error" role="alert" class="mt-4 text-sm text-destructive"></p>
    </Card>
  </main>

  <script>
      import { supabaseBrowser } from '../lib/supabase-browser';
      import { validateLoginInput, validateResetEmail, redirectTo, translateAuthError } from '../lib/auth';

      const form = document.getElementById('login-form') as HTMLFormElement;
      const errorEl = document.getElementById('error')!;

      // 既にログイン済みならダッシュボードへ
      const { data: { session } } = await supabaseBrowser.auth.getSession();
      if (session) {
        redirectTo('/dashboard');
      } else {
        const setMessage = (text: string, tone: 'error' | 'info') => {
          errorEl.textContent = text;
          errorEl.classList.toggle('text-destructive', tone === 'error');
          errorEl.classList.toggle('text-muted-foreground', tone === 'info');
        };

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          setMessage('', 'error');
          const email = (document.getElementById('email') as HTMLInputElement).value.trim();
          const password = (document.getElementById('password') as HTMLInputElement).value;

          const validationError = validateLoginInput(email, password);
          if (validationError) { setMessage(validationError, 'error'); return; }

          const { error } = await supabaseBrowser.auth.signInWithPassword({ email, password });
          if (error) { setMessage(translateAuthError(error), 'error'); console.error(error); return; }
          redirectTo('/dashboard');
        });

        document.getElementById('forgot-password')!.addEventListener('click', async () => {
          setMessage('', 'error');
          const email = (document.getElementById('email') as HTMLInputElement).value.trim();
          const validationError = validateResetEmail(email);
          if (validationError) { setMessage(validationError, 'error'); return; }

          const { error } = await supabaseBrowser.auth.resetPasswordForEmail(email, {
            redirectTo: `${window.location.origin}/set-password`,
          });
          const isRateLimit = error && (
            error.message.toLowerCase().includes('rate limit')
            || error.message.includes('you can only request this after')
          );
          if (isRateLimit) {
            setMessage(translateAuthError(error), 'error');
            return;
          }
          if (error) console.error(error);
          // 列挙攻撃対策: メールが実在するかに関わらず同じ文言を出す(レート制限は
          // メールの実在有無と無関係に起きるので、これだけは正直に伝えて良い)。
          setMessage('このメールアドレス宛てにパスワード再設定用のリンクを送信しました(登録がある場合)。', 'info');
        });
      }
    </script>
</AdminLayout>
