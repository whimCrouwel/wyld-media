---
import AdminShell from '../components/templates/AdminShell.astro';
import Card from '../components/atoms/Card.astro';
import Button from '../components/atoms/Button.astro';
import Field from '../components/molecules/Field.astro';
import Label from '../components/atoms/Label.astro';
import Select from '../components/atoms/Select.astro';
import { REGIONS } from '../lib/regions';

const title = 'ユーザー管理 | Wild Media CMS';
---
<AdminShell title={title} heading="ユーザー管理" wide>
  <div class="space-y-6">
    <Card class="p-6">
      <h2 class="mb-4 text-lg font-semibold tracking-tight">新しいユーザーを招待</h2>
      <form id="invite-form" class="space-y-4">
        <Field id="inv-email" label="メールアドレス" type="email" required />
        <Field id="inv-name" label="名前" type="text" required />
        <Field id="inv-slug" label="スラッグ(小文字英数字とハイフン)" type="text" required />
        <Field id="inv-region" label="活動拠点(エリア)" as="select">
          <option value="">未設定</option>
          {REGIONS.map((r) => <option value={r}>{r}</option>)}
        </Field>
        <div class="space-y-2">
          <Label for="inv-role">種別</Label>
          <Select id="inv-role">
            <option value="writer">ライター</option>
            <option value="provider">サービスプロバイダー</option>
          </Select>
        </div>
        <label id="inv-certified-row" hidden class="flex items-center gap-2 text-sm">
          <input id="inv-certified" type="checkbox" class="h-4 w-4 rounded border-input" />
          認定事業者として招待する
        </label>
        <Button type="submit">招待メールを送信</Button>
      </form>
    </Card>

    <Card class="p-6">
      <h2 class="mb-4 text-lg font-semibold tracking-tight">ユーザー一覧</h2>
      <table class="admin-table">
        <thead>
          <tr><th>名前</th><th>スラッグ</th><th>種別</th><th>認定</th><th>操作</th></tr>
        </thead>
        <tbody id="user-rows"><tr><td colspan="5">読み込み中…</td></tr></tbody>
      </table>
    </Card>

    <p id="message" role="alert" class="text-sm text-muted-foreground"></p>
  </div>

  <script>
      import { supabaseBrowser } from '../lib/supabase-browser';
      import { redirectTo } from '../lib/auth';
      import {
        fetchAllProfiles, updateUserRole, updateProviderCertification,
        validateInviteInput, inviteUser, translateInviteError,
        deleteUser, translateDeleteUserError,
      } from '../lib/admin';
      import { initShellChrome } from '../lib/shell';
      import { initConfirmDialog } from '../lib/confirm-dialog';

      const { data: { session } } = await supabaseBrowser.auth.getSession();
      if (!session) {
        redirectTo('/login');
      } else {
        const { role, roleLookupFailed } = await initShellChrome(supabaseBrowser);
        if (roleLookupFailed) {
          // リダイレクトループを避けるため、ここではリダイレクトしない。
          document.getElementById('message')!.textContent =
            '権限の確認に失敗しました。ページを再読み込みしてください。';
        } else if (role !== 'admin') {
          // UX のためのリダイレクト。実際の防壁は RLS/トリガー。
          redirectTo('/dashboard');
        } else {
        const messageEl = document.getElementById('message')!;
        const tbody = document.getElementById('user-rows')!;
        const $ = (id: string) => document.getElementById(id) as HTMLInputElement & HTMLSelectElement;
        const myId = session.user.id;
        const confirmDialog = initConfirmDialog(
          document.getElementById('confirm-dialog') as HTMLDialogElement,
        );

        const renderRows = async () => {
          const profiles = await fetchAllProfiles(supabaseBrowser);
          tbody.innerHTML = '';
          for (const p of profiles) {
            const tr = document.createElement('tr');
            const nameTd = document.createElement('td');
            nameTd.textContent = p.name;
            const slugTd = document.createElement('td');
            slugTd.textContent = p.slug;
            const roleTd = document.createElement('td');
            if (p.role === 'admin') {
              roleTd.textContent = '管理者';
            } else {
              const sel = document.createElement('select');
              for (const [value, label] of [['writer', 'ライター'], ['provider', 'サービスプロバイダー']] as const) {
                const o = document.createElement('option');
                o.value = value;
                o.textContent = label;
                o.selected = p.role === value;
                sel.appendChild(o);
              }
              const btn = document.createElement('button');
              btn.type = 'button';
              btn.textContent = '変更';
              btn.addEventListener('click', async () => {
                messageEl.textContent = '';
                try {
                  await updateUserRole(supabaseBrowser, p.id, sel.value as 'writer' | 'provider');
                } catch (err) {
                  messageEl.textContent = '種別の変更に失敗しました。';
                  console.error(err);
                  return;
                }
                messageEl.textContent = `${p.name} の種別を変更しました。`;
                try {
                  await renderRows();
                } catch (err) {
                  messageEl.textContent += ' 一覧の再読み込みに失敗しました。ページを再読み込みしてください。';
                  console.error(err);
                }
              });
              roleTd.appendChild(sel);
              roleTd.appendChild(btn);
            }

            const certifiedTd = document.createElement('td');
            if (p.role === 'provider') {
              const badge = document.createElement('span');
              badge.className = 'rounded-full bg-secondary px-2 py-1 text-xs font-medium text-secondary-foreground';
              badge.textContent = p.certified ? '認定済み' : '未認定';
              badge.hidden = !p.certified;

              const toggleBtn = document.createElement('button');
              toggleBtn.type = 'button';
              toggleBtn.textContent = p.certified ? '認定を解除' : '認定する';
              toggleBtn.addEventListener('click', async () => {
                messageEl.textContent = '';
                try {
                  await updateProviderCertification(supabaseBrowser, p.id, !p.certified);
                } catch (err) {
                  messageEl.textContent = '認定状態の変更に失敗しました。';
                  console.error(err);
                  return;
                }
                messageEl.textContent = `${p.name} の認定状態を変更しました。`;
                try {
                  await renderRows();
                } catch (err) {
                  messageEl.textContent += ' 一覧の再読み込みに失敗しました。ページを再読み込みしてください。';
                  console.error(err);
                }
              });

              certifiedTd.appendChild(badge);
              certifiedTd.appendChild(toggleBtn);
            }

            const actionsTd = document.createElement('td');
            if (p.id !== myId) {
              const delBtn = document.createElement('button');
              delBtn.type = 'button';
              delBtn.textContent = '削除';
              delBtn.addEventListener('click', async () => {
                messageEl.textContent = '';
                const ok = await confirmDialog.confirm({
                  title: 'ユーザーを削除しますか?',
                  body: `「${p.name}」を削除します。この操作は取り消せません。`,
                  confirmLabel: '削除する',
                });
                if (!ok) return;
                try {
                  await deleteUser(supabaseBrowser, p.id);
                } catch (err) {
                  messageEl.textContent = translateDeleteUserError(err);
                  console.error(err);
                  return;
                }
                messageEl.textContent = `${p.name} を削除しました。`;
                try {
                  await renderRows();
                } catch (err) {
                  messageEl.textContent += ' 一覧の再読み込みに失敗しました。ページを再読み込みしてください。';
                  console.error(err);
                }
              });
              actionsTd.appendChild(delBtn);
            }

            tr.appendChild(nameTd);
            tr.appendChild(slugTd);
            tr.appendChild(roleTd);
            tr.appendChild(certifiedTd);
            tr.appendChild(actionsTd);
            tbody.appendChild(tr);
          }
        };

        try {
          await renderRows();
        } catch (err) {
          tbody.innerHTML = '<tr><td colspan="5">読み込みに失敗しました。</td></tr>';
          console.error(err);
        }

        const inviteForm = document.getElementById('invite-form') as HTMLFormElement;
        const inviteBtn = inviteForm.querySelector('button[type="submit"]') as HTMLButtonElement;
        const certifiedRow = document.getElementById('inv-certified-row') as HTMLLabelElement;
        let inviteInFlight = false;

        const syncCertifiedVisibility = () => {
          const isProvider = $('inv-role').value === 'provider';
          certifiedRow.hidden = !isProvider;
          if (!isProvider) $('inv-certified').checked = false;
        };
        $('inv-role').addEventListener('change', syncCertifiedVisibility);
        syncCertifiedVisibility();

        inviteForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (inviteInFlight) return;
          messageEl.textContent = '';
          const role = $('inv-role').value as 'writer' | 'provider';
          const input = {
            email: $('inv-email').value.trim(),
            name: $('inv-name').value.trim(),
            slug: $('inv-slug').value.trim(),
            role,
            certified: role === 'provider' ? $('inv-certified').checked : false,
            region: $('inv-region').value || undefined,
          };
          const validationError = validateInviteInput(input);
          if (validationError) { messageEl.textContent = validationError; return; }
          inviteInFlight = true;
          inviteBtn.disabled = true;
          try {
            try {
              await inviteUser(supabaseBrowser, input);
            } catch (err) {
              messageEl.textContent = translateInviteError(err);
              console.error(err);
              return;
            }
            messageEl.textContent = `${input.email} に招待メールを送信しました。`;
            inviteForm.reset();
            syncCertifiedVisibility();
            try {
              await renderRows();
            } catch (err) {
              messageEl.textContent += ' 一覧の再読み込みに失敗しました。ページを再読み込みしてください。';
              console.error(err);
            }
          } finally {
            inviteInFlight = false;
            inviteBtn.disabled = false;
          }
        });
      }
      }
    </script>
</AdminShell>
