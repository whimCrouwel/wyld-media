---
import { cn } from '../../lib/cn';
import Button from './Button.astro';

interface Props {
  id: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---
<dialog
  id={id}
  class={cn(
    'fixed top-1/2 left-1/2 w-full max-w-md -translate-x-1/2 -translate-y-1/2 rounded-lg border bg-card p-6 text-card-foreground shadow-lg backdrop:bg-black/50',
    className,
  )}
>
  <h2 data-info-title class="text-lg font-semibold"></h2>
  <p data-info-body class="mt-3 whitespace-pre-wrap text-sm text-muted-foreground"></p>
  <a data-info-link hidden href="#" class="mt-4 inline-block text-sm font-medium text-primary underline underline-offset-2 hover:opacity-80"></a>
  <div class="mt-6 flex justify-end">
    <Button type="button" variant="outline" size="sm" data-role="close">閉じる</Button>
  </div>
</dialog>
