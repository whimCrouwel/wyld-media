---
import { cn } from '../../lib/cn';
import {
  buttonBase as base,
  buttonVariants as variants,
  buttonSizes as sizes,
  type ButtonVariant as Variant,
  type ButtonSize as Size,
} from '../../lib/button-variants';

interface Props {
  variant?: Variant;
  size?: Size;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  id?: string;
}

const { variant = 'default', size = 'default', type = 'button', class: className, ...rest } = Astro.props;
---
<button type={type} class={cn(base, variants[variant], sizes[size], className)} {...rest}>
  <slot />
</button>
