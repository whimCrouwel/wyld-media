---
import { cn } from '../../lib/cn';

interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---
<a
  href={href}
  class={cn(
    'inline-flex items-center gap-1 text-sm text-muted-foreground transition-colors hover:text-foreground',
    className,
  )}
>
  <slot />
</a>
