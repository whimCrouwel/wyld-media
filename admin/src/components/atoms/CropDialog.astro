---
import { cn } from '../../lib/cn';
import Button from './Button.astro';

// 本文画像挿入用のトリミングモーダル。crop-dialog.ts(initCropDialog)が配線する。
interface Props {
  id: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---
<dialog
  id={id}
  class={cn(
    // ConfirmDialog と同じ理由で fixed + translate 中央固定(preflight が margin をリセットするため)
    'fixed top-1/2 left-1/2 w-full max-w-2xl -translate-x-1/2 -translate-y-1/2 rounded-lg border bg-card p-6 text-card-foreground shadow-lg backdrop:bg-black/50',
    className,
  )}
>
  <h2 class="text-lg font-semibold">画像を切り抜く</h2>
  <p class="mt-1 text-sm text-muted-foreground">
    範囲をドラッグして調整できます。そのまま挿入する場合は範囲を変えずに「切り抜いて挿入」を押してください。
  </p>
  <div class="mt-3 flex flex-wrap items-center gap-2" data-role="ratios">
    <span class="text-sm text-muted-foreground">縦横比:</span>
    <Button type="button" variant="outline" size="sm" data-ratio="free" aria-pressed="true">自由</Button>
    <Button type="button" variant="outline" size="sm" data-ratio="16:9" aria-pressed="false">16:9</Button>
    <Button type="button" variant="outline" size="sm" data-ratio="4:3" aria-pressed="false">4:3</Button>
    <Button type="button" variant="outline" size="sm" data-ratio="1:1" aria-pressed="false">1:1</Button>
  </div>
  <div data-role="crop-box" class="mt-3 max-h-[60vh] overflow-hidden"></div>
  <div class="mt-6 flex items-center justify-end gap-3">
    <span data-role="status" role="status" class="mr-auto text-sm text-muted-foreground"></span>
    <Button type="button" variant="outline" size="sm" data-role="cancel">キャンセル</Button>
    <Button type="button" variant="secondary" size="sm" data-role="apply">切り抜いて挿入</Button>
  </div>
</dialog>
