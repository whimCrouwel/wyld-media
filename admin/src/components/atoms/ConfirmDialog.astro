---
import { cn } from '../../lib/cn';
import Button from './Button.astro';

interface Props {
  id: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---
<dialog
  id={id}
  class={cn(
    // Tailwind preflight が margin をリセットするため、dialog 標準の
    // `margin: auto` 中央寄せが効かない。fixed + translate で明示的に中央固定する。
    'fixed top-1/2 left-1/2 w-full max-w-sm -translate-x-1/2 -translate-y-1/2 rounded-lg border bg-card p-6 text-card-foreground shadow-lg backdrop:bg-black/50',
    className,
  )}
>
  <div class="flex items-start gap-3">
    <span
      class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-destructive/10 text-destructive"
      aria-hidden="true"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5"
      >
        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
        <line x1="12" y1="9" x2="12" y2="13" />
        <line x1="12" y1="17" x2="12.01" y2="17" />
      </svg>
    </span>
    <div class="min-w-0 flex-1">
      <h2 data-confirm-title class="text-lg font-semibold"></h2>
      <p data-confirm-body class="mt-1 text-sm text-muted-foreground"></p>
    </div>
  </div>
  <div class="mt-6 flex justify-end gap-2">
    <Button type="button" variant="outline" size="sm" data-role="cancel" />
    <Button type="button" variant="destructive" size="sm" data-role="confirm" />
  </div>
</dialog>
