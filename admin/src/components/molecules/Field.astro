---
import Label from '../atoms/Label.astro';
import Input from '../atoms/Input.astro';
import Textarea from '../atoms/Textarea.astro';
import Select from '../atoms/Select.astro';

interface Props {
  id: string;
  label: string;
  as?: 'input' | 'textarea' | 'select';
  type?: string;
  required?: boolean;
  name?: string;
  rows?: number;
  [key: string]: unknown;
}

const { id, label, as = 'input', type = 'text', ...rest } = Astro.props;
---
<div id={`${id}-field`} class="space-y-2">
  <div class="flex items-center gap-1.5">
    <Label for={id} id={`${id}-label`}>{label}</Label>
    <slot name="info" />
  </div>
  {
    as === 'textarea' ? (
      <Textarea id={id} {...rest} />
    ) : as === 'select' ? (
      <Select id={id} {...rest}><slot /></Select>
    ) : (
      <Input id={id} type={type} {...rest} />
    )
  }
</div>
