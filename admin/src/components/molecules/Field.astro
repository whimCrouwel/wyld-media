---
import Label from '../atoms/Label.astro';
import Input from '../atoms/Input.astro';

interface Props {
  id: string;
  label: string;
  type?: string;
  required?: boolean;
  name?: string;
}

const { id, label, type = 'text', required, name } = Astro.props;
---
<div class="space-y-2">
  <Label for={id}>{label}</Label>
  <Input id={id} type={type} name={name} required={required} />
</div>
