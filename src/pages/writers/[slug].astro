---
import Base from '../../layouts/Base.astro';
import MetaLabel from '../../components/atoms/MetaLabel.astro';
import SectionHeader from '../../components/molecules/SectionHeader.astro';
import SocialIcon from '../../components/atoms/SocialIcon.astro';
import Breadcrumbs from '../../components/molecules/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import { supabaseServer } from '../../lib/supabase-server';
import { fetchWriters, fetchWriterBySlug, formatDate } from '../../lib/content';
import type { WriterDetail } from '../../lib/content';
import { detectSocialPlatform } from '../../lib/social-links';
import { fallbackDescription } from '../../lib/description';
import { personSchema, breadcrumbListSchema, buildCrumbs } from '../../lib/schema';

export async function getStaticPaths() {
  const writers = await fetchWriters(supabaseServer);
  const details = await Promise.all(
    writers.map((w) => fetchWriterBySlug(supabaseServer, w.slug)),
  );
  return details
    .filter((d): d is WriterDetail => d !== null)
    .map((writer) => ({ params: { slug: writer.slug }, props: { writer } }));
}

interface Props {
  writer: WriterDetail;
}
const { writer } = Astro.props;
const hasCover = Boolean(writer.coverImageUrl);

if (!Astro.site) throw new Error('writers/[slug]: Astro.site is undefined.');
const siteUrl = Astro.site.href;
const personLd = personSchema({
  name: writer.name,
  url: new URL(`/writers/${writer.slug}`, siteUrl).href,
  bio: writer.bio ?? '',
  avatarUrl: writer.avatarUrl,
  snsLinks: writer.snsLinks,
});
const crumbs = buildCrumbs.writer({ name: writer.name, slug: writer.slug });
const crumbsLd = breadcrumbListSchema(crumbs, siteUrl);
---
<Base
  title={`${writer.name} | Wild Media`}
  description={writer.bio ? fallbackDescription(writer.bio) : `${writer.name}の記事一覧 — Wild Media`}
  canonicalPath={`/writers/${writer.slug}`}
  ogImage={writer.avatarUrl ?? undefined}
  ogType="profile"
  padMain={!hasCover}
>
  <Fragment slot="head">
    <JsonLd data={personLd} />
    <JsonLd data={crumbsLd} />
  </Fragment>

  {/* カバーバナー(未設定なら省略)。上部は古紙色のスクリムで固定ヘッダーの可読性を保つ */}
  {
    hasCover && (
      <div class="relative h-[clamp(180px,30vh,300px)] w-full overflow-hidden">
        <img
          src={writer.coverImageUrl}
          alt={`${writer.name}のカバー画像`}
          class="absolute inset-0 h-full w-full object-cover"
          loading="eager"
          decoding="async"
        />
        <div
          class="absolute inset-x-0 top-0 h-36"
          style="background: linear-gradient(to bottom, var(--color-bg) 0%, var(--color-bg) 42%, transparent 100%);"
        />
      </div>
    )
  }

  <div class="mx-auto max-w-4xl px-6 pb-24">
    <Breadcrumbs crumbs={crumbs} class="mb-6" />
    {/* アバター(角丸スクエア)。カバーがある時は少し重ねる */}
    <div class={hasCover ? 'relative z-10 -mt-14' : ''}>
      <span
        class="block w-[120px] overflow-hidden rounded-[18px]"
        style="box-shadow: 0 0 0 5px var(--color-bg); background: var(--color-bg);"
      >
        {
          writer.avatarUrl ? (
            <img
              src={writer.avatarUrl}
              alt={writer.name}
              width={120}
              height={120}
              class="block aspect-square w-full object-cover"
              loading="eager"
              decoding="async"
            />
          ) : (
            <span
              class="border-card text-meta flex aspect-square w-full items-center justify-center border"
              style="font-family: var(--font-heading); font-size: 44px;"
            >
              {writer.name.trim().charAt(0)}
            </span>
          )
        }
      </span>
    </div>

    {/* 名前 + 右上アクション */}
    <div class="mt-6 flex flex-wrap items-start justify-between gap-x-6 gap-y-5">
      <div class="min-w-0">
        <h1
          style="font-family: var(--font-heading); font-size: clamp(30px, 5vw, 46px); line-height: 1.2;"
        >
          {writer.name}
        </h1>
        <p class="mt-2">
          <MetaLabel>
            @{writer.slug}
            {(writer.region || writer.location) && (
              <span> ・ {[writer.region, writer.location].filter(Boolean).join(' ')}</span>
            )}
          </MetaLabel>
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        {
          writer.homepageUrl && (
            <a
              href={writer.homepageUrl}
              class="border-card hover:border-ink rounded-full border px-5 py-2.5 transition-colors"
            >
              <MetaLabel class="text-ink">ホームページ ↗</MetaLabel>
            </a>
          )
        }
        {
          writer.contactUrl && (
            <a
              href={writer.contactUrl}
              class="bg-ink rounded-full px-5 py-2.5 transition-opacity hover:opacity-80"
            >
              <MetaLabel style="color: var(--color-bg);">取材を依頼する</MetaLabel>
            </a>
          )
        }
      </div>
    </div>

    {writer.bio && <p class="text-meta mt-8 max-w-2xl" style="line-height: 1.9;">{writer.bio}</p>}

    {
      writer.snsLinks.length > 0 && (
        <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2">
          {writer.snsLinks.map((url) => {
            const social = detectSocialPlatform(url);
            return social ? (
              <a
                href={url}
                aria-label={social.label}
                class="bg-ink flex h-9 w-9 items-center justify-center rounded-full transition-opacity hover:opacity-80"
                style="color: var(--color-bg);"
              >
                <SocialIcon platform={social.platform} />
              </a>
            ) : (
              <a
                href={url}
                class="text-ink underline underline-offset-4 transition-opacity hover:opacity-60"
                style="text-decoration-color: var(--color-ink);"
              >
                {new URL(url).hostname}
              </a>
            );
          })}
        </div>
      )
    }

    {/* 記事カード(2カラム)。サムネイル + 日付 + タイトル */}
    {
      writer.articles.length > 0 && (
        <>
          <SectionHeader label="Works" count={writer.articles.length} class="mt-14 pb-5" />
          <div class="grid gap-4 sm:grid-cols-2">
            {writer.articles.map((a) => (
              <a
                href={`/articles/${a.slug}`}
                class="border-card hover:border-ink flex items-center gap-4 rounded-[16px] border p-3 transition-colors"
              >
                {a.coverImageUrl ? (
                  <img
                    src={a.coverImageUrl}
                    alt=""
                    class="bg-card h-[72px] w-[72px] shrink-0 rounded-[12px] object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="bg-card h-[72px] w-[72px] shrink-0 rounded-[12px]" />
                )}
                <span class="min-w-0">
                  <MetaLabel class="block tabular-nums">{formatDate(a.publishedAt)}</MetaLabel>
                  <span
                    class="mt-1 block line-clamp-2"
                    style="font-family: var(--font-heading); font-size: 16px; line-height: 1.4;"
                  >
                    {a.title}
                  </span>
                </span>
              </a>
            ))}
          </div>
        </>
      )
    }

    {/* 料金プラン(pricing_items) */}
    {
      writer.pricingItems.length > 0 && (
        <div class="border-card mt-6 rounded-[16px] border px-6 py-5">
          <div class="mb-3 flex items-baseline justify-between gap-3">
            <MetaLabel>料金プラン</MetaLabel>
            <MetaLabel>ライターが自由に設定</MetaLabel>
          </div>
          <ul class="divide-border/60 divide-y">
            {writer.pricingItems.map((p) => (
              <li class="flex flex-wrap items-baseline justify-between gap-3 py-3">
                <span
                  class="min-w-0"
                  style="font-family: var(--font-heading); font-size: 16px; line-height: 1.4;"
                >
                  {p.label}
                  {p.unit && (
                    <MetaLabel class="ml-2 inline-block">/ {p.unit}</MetaLabel>
                  )}
                </span>
                <span
                  class="tabular-nums"
                  style="font-family: var(--font-heading); font-size: 18px; font-weight: 600;"
                >
                  ¥{p.amount.toLocaleString('ja-JP')}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</Base>
