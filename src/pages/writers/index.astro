---
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/molecules/SectionHeader.astro';
import WriterAvatar from '../../components/atoms/WriterAvatar.astro';
import { supabaseServer } from '../../lib/supabase-server';
import { fetchWriters } from '../../lib/content';
import { buildAreaLinks } from '../../lib/sidebar';

const writers = await fetchWriters(supabaseServer);
// このページだけ、サイドバーの地図を「記事の地域ブラウズ」ではなく
// 「ライターを地域で絞り込む」フィルタとして使う(areaMode="filter")。
// 件数は記事ではなくライターの居住地域でカウントし直す。
const writerAreas = buildAreaLinks(writers.map((w) => w.region));
---
<Base
  title="ライター一覧 | Wild Media"
  description="Wild Media に寄稿するライターの一覧。それぞれの視点と専門から、環境と暮らしを書く。"
  canonicalPath="/writers"
  areaMode="filter"
  areaLinks={writerAreas}
>
  <div class="px-6 pb-24">
    <SectionHeader
      label="Writers"
      count={writers.length}
      countId="writer-count"
      subLabelId="active-region-label"
      class="pb-14"
    />

    <ul id="writer-list" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        writers.map((w) => (
          <li data-region={w.region ?? ''}>
            <a
              href={`/writers/${w.slug}`}
              class="card hover:border-ink group flex h-full flex-col gap-4 p-6 transition-colors"
            >
              <span class="flex items-center gap-4">
                <WriterAvatar src={w.avatarUrl} name={w.name} size={56} />
                <span class="min-w-0">
                  <span
                    class="block"
                    style="font-family: var(--font-heading); font-size: clamp(18px, 2vw, 22px); line-height: 1.3;"
                  >
                    {w.name}
                  </span>
                  {w.title && <span class="text-meta mt-0.5 block text-sm">{w.title}</span>}
                </span>
              </span>
              {(w.region || w.location) && (
                <span class="chip-row">
                  {w.region && (
                    <span class="chip">
                      <span class="chip-label">Area</span>
                      <span class="chip-value">{w.region}</span>
                    </span>
                  )}
                  {w.location && (
                    <span class="chip chip-accent">
                      <span class="chip-label">Location</span>
                      <span class="chip-value">{w.location}</span>
                    </span>
                  )}
                </span>
              )}
              <p class="text-meta line-clamp-3" style="line-height: 1.9;">{w.bio}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<script>
  import '../../scripts/writer-filter';
</script>
