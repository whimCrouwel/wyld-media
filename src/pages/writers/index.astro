---
import Base from '../../layouts/Base.astro';
import MetaLabel from '../../components/atoms/MetaLabel.astro';
import WriterAvatar from '../../components/atoms/WriterAvatar.astro';
import { supabaseServer } from '../../lib/supabase-server';
import { fetchWriters } from '../../lib/content';
import { usedRegions } from '../../lib/regions';

const writers = await fetchWriters(supabaseServer);
// 該当ライターがいないエリアはボタンを出さない(押しても0件になるだけなので)
const regions = usedRegions(writers.map((w) => w.region));
---
<Base title="ライター一覧 | Wild Media">
  <div class="px-6 pt-32 pb-24">
    <div class="border-card flex items-baseline justify-between border-t pt-3 pb-14">
      <MetaLabel class="text-ink">Writers</MetaLabel>
      <MetaLabel id="writer-count" class="tabular-nums">
        {String(writers.length).padStart(2, '0')}
      </MetaLabel>
    </div>

    {
      regions.length > 1 && (
        <nav id="region-filter" class="-mt-8 flex flex-wrap gap-x-6 gap-y-2 pb-10">
          <button type="button" class="region-chip is-active" data-region="" aria-pressed="true">
            すべて
          </button>
          {regions.map((r) => (
            <button type="button" class="region-chip" data-region={r} aria-pressed="false">
              {r}
            </button>
          ))}
        </nav>
      )
    }

    <ul id="writer-list">
      {
        writers.map((w) => (
          <li class="border-card border-b" data-region={w.region ?? ''}>
            <a
              href={`/writers/${w.slug}`}
              class="group flex items-center gap-8 py-8 transition-opacity hover:opacity-70"
            >
              <WriterAvatar src={w.avatarUrl} name={w.name} size={72} />
              <span class="min-w-0 flex-1">
                <span class="flex flex-wrap items-baseline gap-x-5 gap-y-1">
                  <span
                    style="font-family: var(--font-heading); font-size: clamp(20px, 2.5vw, 26px); line-height: 1.3;"
                  >
                    {w.name}
                  </span>
                  {(w.region || w.location) && (
                    <MetaLabel>{[w.region, w.location].filter(Boolean).join(' ')}</MetaLabel>
                  )}
                </span>
                <p class="text-meta mt-1.5 max-w-xl" style="line-height: 1.9;">{w.bio}</p>
              </span>
              <MetaLabel class="hidden shrink-0 sm:block">→</MetaLabel>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<script>
  import '../../scripts/writer-filter';
</script>

<style>
  /* 絞り込みボタンは .meta と同じ小さな欧文メタ。選択中だけ本文色 + 下線 */
  .region-chip {
    font-family: var(--font-accent);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--color-meta);
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .region-chip:hover {
    color: var(--color-ink);
  }

  .region-chip.is-active {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 5px;
  }
</style>
