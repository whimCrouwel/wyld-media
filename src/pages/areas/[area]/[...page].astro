---
import type { GetStaticPaths, Page } from 'astro';
import Base from '../../../layouts/Base.astro';
import MasonryGrid from '../../../components/organisms/MasonryGrid.astro';
import LoadMore from '../../../components/molecules/LoadMore.astro';
import SectionHeader from '../../../components/molecules/SectionHeader.astro';
import { supabaseServer } from '../../../lib/supabase-server';
import { fetchPublishedArticles, fetchPageSize } from '../../../lib/content';
import { buildGalleryWork } from '../../../lib/images';
import { regionSlug, type Region } from '../../../lib/regions';
import type { ArticleSummary } from '../../../lib/content';

// カタログ番号を持ち回るための最小単位。region 内の順番ではなく、
// 公開順の全体インデックス(globalIndex)を保持しておき、home と同じ式で
// 番号を出す(buildGalleryWork 参照)。
interface RegionItem {
  article: ArticleSummary;
  globalIndex: number;
}

// 全記事を1回だけ取り、メモリ上で地域ごとに分けてから paginate に渡す。
// 地域ごとにクエリを投げると地域数 × ページ数のクエリになる。
export const getStaticPaths = (async ({ paginate }) => {
  const { featured, normal } = await fetchPublishedArticles(supabaseServer);
  const pageSize = await fetchPageSize(supabaseServer);
  const all = [...featured, ...normal];
  const total = all.length;

  // 地域ごとに分けつつ、番号は「全作品通し番号」(/ と同じ基準)のまま持ち回る。
  // 地域内の順番で振り直すと同じ記事が / と /areas/xxx で違う番号になる
  // (このバグの実体だった)。
  const byRegion = new Map<string, RegionItem[]>();
  all.forEach((article, globalIndex) => {
    if (!article.region) return;
    const list = byRegion.get(article.region) ?? [];
    list.push({ article, globalIndex });
    byRegion.set(article.region, list);
  });

  return [...byRegion.entries()].flatMap(([region, items]) =>
    paginate(items, {
      pageSize,
      params: { area: regionSlug(region as Region) },
      props: { region, total },
    }),
  );
}) satisfies GetStaticPaths;

interface Props {
  page: Page<RegionItem>;
  region: string;
  total: number;
}
const { page, region, total } = Astro.props;
const area = Astro.params.area as string;

const works = await Promise.all(
  page.data.map(({ article, globalIndex }) =>
    buildGalleryWork(article, globalIndex, total - globalIndex),
  ),
);
---
<Base title={`${region}の記事 | Wild Media`} activeAreaSlug={area}>
  <section>
    <SectionHeader label={region} count={page.total} class="mx-6 pb-6" />
    <MasonryGrid works={works} />
    <LoadMore page={page} />
  </section>
</Base>
