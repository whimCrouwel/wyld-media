---
import Base from '../../layouts/Base.astro';
import MetaLabel from '../../components/atoms/MetaLabel.astro';
import Breadcrumbs from '../../components/molecules/Breadcrumbs.astro';
import AuthorCard from '../../components/molecules/AuthorCard.astro';
import RelatedArticles from '../../components/molecules/RelatedArticles.astro';
import TableOfContents from '../../components/molecules/TableOfContents.astro';
import JsonLd from '../../components/JsonLd.astro';
import { supabaseServer } from '../../lib/supabase-server';
import { fetchPublishedArticles, fetchArticleBySlug, fetchRelatedArticles, formatDate } from '../../lib/content';
import type { ArticleDetail } from '../../lib/content';
import { articleSchema, breadcrumbListSchema, buildCrumbs } from '../../lib/schema';

export async function getStaticPaths() {
  const { featured, normal } = await fetchPublishedArticles(supabaseServer);
  const details = await Promise.all(
    [...featured, ...normal].map((a) => fetchArticleBySlug(supabaseServer, a.slug)),
  );
  return details
    .filter((d): d is ArticleDetail => d !== null)
    .map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

interface Props {
  article: ArticleDetail;
}
const { article } = Astro.props;
const relatedArticles = await fetchRelatedArticles(supabaseServer, article, { limit: 6 });

// Validate Astro.site and article data
if (!Astro.site) throw new Error('articles/[slug]: Astro.site is undefined.');
if (!article.publishedAtISO) throw new Error('articles/[slug]: publishedAtISO missing for published article');

const siteUrl = Astro.site.href;
const canonical = new URL(`/articles/${article.slug}`, siteUrl).href;
const crumbs = buildCrumbs.article({ title: article.title, slug: article.slug });

const articleLd = articleSchema({
  title: article.title,
  description: article.description,
  url: canonical,
  coverUrl: article.coverImageUrl,
  publishedISO: article.publishedAtISO,
  updatedISO: article.updatedAtISO,
  authorName: article.authorName,
  authorUrl: new URL(`/writers/${article.authorSlug}`, siteUrl).href,
  siteName: 'Wild Media',
  siteUrl,
});
const crumbsLd = breadcrumbListSchema(crumbs, siteUrl);
---
<Base
  title={`${article.title} | Wild Media`}
  description={article.description}
  canonicalPath={`/articles/${article.slug}`}
  ogImage={article.coverImageUrl ?? undefined}
  ogType="article"
  articlePublishedTime={article.publishedAtISO}
  articleModifiedTime={article.updatedAtISO}
  articleAuthor={article.authorName}
>
  <Fragment slot="head">
    <JsonLd data={articleLd} />
    <JsonLd data={crumbsLd} />
  </Fragment>
  <article class="mx-auto max-w-4xl px-6 pb-24">
    <Breadcrumbs crumbs={crumbs} class="mb-6" />

    {/* 記事本体を1枚の面にまとめる器。個々のカード(目次)が bg-card を持つ
        ようになった結果、地の点グリッドの上に浮き輪のように散らばって見え
        記事としてのまとまりが失われたため、タイトルから本文まで丸ごと
        bg-bg の1枚に収める(パンくず/戻るリンクはページの案内なので器の
        外に残す)。 */}
    <div class="bg-bg border-hairline rounded-[28px] border p-6 sm:p-10">
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
        <a href={`/writers/${article.authorSlug}`} class="transition-opacity hover:opacity-60">
          <MetaLabel class="text-ink">{article.authorName}</MetaLabel>
        </a>
        <MetaLabel>{formatDate(article.publishedAt)}</MetaLabel>
        {article.commissionedByName && <MetaLabel>提供: {article.commissionedByName}</MetaLabel>}
      </div>
      <h1
        class="mt-4"
        style="font-family: var(--font-heading); font-size: clamp(28px, 4vw, 40px); line-height: 1.3;"
      >
        {article.title}
      </h1>

      {
        article.coverImageUrl && (
          <div class="mt-10 overflow-hidden rounded-[12px]">
            <img src={article.coverImageUrl} alt={`${article.title}のカバー画像`} class="w-full" decoding="async" />
          </div>
        )
      }

      {article.headings.length >= 2 && <TableOfContents headings={article.headings} />}

      <div class="article-body mt-12" set:html={article.bodyHtml} />

      {/* 読者の匿名ブックマーク。ログイン不要(localStorage の token + toggle_bookmark RPC)。
          初期状態は bookmark-button.ts が実行時に描画するため hidden で出す。 */}
      <div class="mt-12 flex justify-center">
        <button
          id="bookmark-button"
          type="button"
          hidden
          aria-pressed="false"
          data-article-id={article.id}
          class="border-hairline text-ink hover:bg-card inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm transition-colors [&.is-bookmarked]:border-transparent [&.is-bookmarked]:bg-ink [&.is-bookmarked]:text-bg"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="[.is-bookmarked_&]:fill-current">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
          </svg>
          <span id="bookmark-label">保存する</span>
          <span id="bookmark-count" class="text-meta tabular-nums">–</span>
        </button>
      </div>
    </div>

    {/* 記事本体とは別の器: 「この記事にまつわる付随情報」(著者・関連記事)を
        まとめる。1つの器に全部入れると本文と同格に見えてしまうため、
        意味のまとまりごとに器を分ける。 */}
    <div class="bg-bg border-hairline mt-8 rounded-[28px] border p-6 sm:p-10">
      <AuthorCard
        name={article.authorName}
        slug={article.authorSlug}
        bio={article.authorBio}
        avatarUrl={article.authorAvatarUrl}
        snsLinks={article.authorSnsLinks}
        class=""
      />

      <RelatedArticles articles={relatedArticles} />
    </div>

    <p class="mt-16">
      <a href="/" class="transition-opacity hover:opacity-60"><MetaLabel>← Works</MetaLabel></a>
    </p>
  </article>

  <script>
    import '../../scripts/bookmark-button';
  </script>
</Base>
