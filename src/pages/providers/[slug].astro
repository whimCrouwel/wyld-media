---
import Base from '../../layouts/Base.astro';
import MetaLabel from '../../components/atoms/MetaLabel.astro';
import SectionHeader from '../../components/molecules/SectionHeader.astro';
import SocialIcon from '../../components/atoms/SocialIcon.astro';
import Button from '../../components/atoms/Button.astro';
import Breadcrumbs from '../../components/molecules/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import { supabaseServer } from '../../lib/supabase-server';
import { fetchProviders, fetchProviderBySlug } from '../../lib/content';
import type { ProviderDetail } from '../../lib/content';
import { detectSocialPlatform } from '../../lib/social-links';
import { fallbackDescription } from '../../lib/description';
import { organizationSchema, breadcrumbListSchema, buildCrumbs } from '../../lib/schema';

export async function getStaticPaths() {
  const providers = await fetchProviders(supabaseServer);
  const details = await Promise.all(
    providers.map((p) => fetchProviderBySlug(supabaseServer, p.slug)),
  );
  return details
    .filter((d): d is ProviderDetail => d !== null)
    .map((provider) => ({ params: { slug: provider.slug }, props: { provider } }));
}

interface Props {
  provider: ProviderDetail;
}
const { provider } = Astro.props;
const hasCover = Boolean(provider.coverImageUrl);

if (!Astro.site) throw new Error('providers/[slug]: Astro.site is undefined.');
const siteUrl = Astro.site.href;
const orgLd = organizationSchema({
  name: provider.name,
  url: new URL(`/providers/${provider.slug}`, siteUrl).href,
  description: provider.bio || undefined,
  sameAs: provider.snsLinks.length > 0 ? provider.snsLinks : undefined,
});
const crumbs = buildCrumbs.provider({ name: provider.name, slug: provider.slug });
const crumbsLd = breadcrumbListSchema(crumbs, siteUrl);
---
<Base
  title={`${provider.name} | Wild Media`}
  description={provider.bio ? fallbackDescription(provider.bio) : `${provider.name} — Wild Media 認定プロバイダー`}
  canonicalPath={`/providers/${provider.slug}`}
  ogImage={provider.coverImageUrl ?? undefined}
  ogType="profile"
  padMain={!hasCover}
>
  <Fragment slot="head">
    <JsonLd data={orgLd} />
    <JsonLd data={crumbsLd} />
  </Fragment>

  {/* カバーバナー(未設定なら省略)。固定ヘッダーが不透明な地色を持つため、ここでは
      画像を素のまま見せる(可読性のためのスクリムは不要)。パンくず・ロゴは
      どちらもこのバナーの外(下)に置き、画像とは重ならない。 */}
  {
    hasCover && (
      <div class="h-[clamp(180px,30vh,300px)] w-full overflow-hidden">
        <img
          src={provider.coverImageUrl}
          alt={`${provider.name}のカバー画像`}
          class="h-full w-full object-cover"
          loading="eager"
          decoding="async"
        />
      </div>
    )
  }

  <div class="mx-auto max-w-4xl px-6 pb-24">
    <Breadcrumbs crumbs={crumbs} class="mt-6 mb-8" />

    {/* ロゴ(左)+ 会社・団体名(右)を1つのグループとして横並びにする */}
    <div class="flex flex-wrap items-center gap-5">
      <span class="rounded-card block w-24 shrink-0 overflow-hidden" style="background: var(--color-bg);">
        {
          provider.avatarUrl ? (
            <img
              src={provider.avatarUrl}
              alt={provider.name}
              width={96}
              height={96}
              class="block aspect-square w-full object-cover"
              loading="eager"
              decoding="async"
            />
          ) : (
            <span
              class="bg-card border-hairline text-meta flex aspect-square w-full items-center justify-center border"
              style="font-family: var(--font-heading); font-size: 36px;"
            >
              {provider.name.trim().charAt(0)}
            </span>
          )
        }
      </span>

      <div class="min-w-0">
        <h1
          style="font-family: var(--font-heading); font-size: clamp(28px, 4vw, 40px); line-height: 1.2;"
        >
          {provider.name}
        </h1>
        <p class="mt-2">
          <MetaLabel>
            @{provider.slug}
            {(provider.region || provider.location) && (
              <span> ・ {[provider.region, provider.location].filter(Boolean).join(' ')}</span>
            )}
          </MetaLabel>
        </p>
      </div>
    </div>

    {/* 右上アクション */}
    {
      provider.homepageUrl && (
        <div class="mt-6">
          <Button href={provider.homepageUrl} variant="outline">
            <MetaLabel class="text-ink">ホームページ ↗</MetaLabel>
          </Button>
        </div>
      )
    }

    {provider.bio && <p class="text-meta mt-8 max-w-2xl" style="line-height: 1.9;">{provider.bio}</p>}

    {
      provider.snsLinks.length > 0 && (
        <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2">
          {provider.snsLinks.map((url) => {
            const social = detectSocialPlatform(url);
            return social ? (
              <a
                href={url}
                aria-label={social.label}
                class="bg-ink flex h-9 w-9 items-center justify-center rounded-full transition-opacity hover:opacity-80"
                style="color: var(--color-bg);"
              >
                <SocialIcon platform={social.platform} />
              </a>
            ) : (
              <a
                href={url}
                class="text-ink underline underline-offset-4 transition-opacity hover:opacity-60"
                style="text-decoration-color: var(--color-ink);"
              >
                {new URL(url).hostname}
              </a>
            );
          })}
        </div>
      )
    }

    {/* 主要サービス。認定プロバイダーだけが得られる公開枠なので、未入力なら
        丸ごと出さない(admin の showServiceTab === certified と同じ条件)。 */}
    {
      provider.serviceName && (
        <>
          <SectionHeader label="Provider's Projects" class="mt-14 pb-6" />
          <div class="card service-card">
            {provider.serviceImageUrl ? (
              <img
                src={provider.serviceImageUrl}
                alt={provider.serviceName ?? provider.name}
                class="service-image"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="service-image service-image-empty" />
            )}
            <div class="service-body">
              <h2 class="service-name">{provider.serviceName}</h2>
              {provider.serviceDescription && <p class="service-desc">{provider.serviceDescription}</p>}
              {provider.serviceUrl && (
                <a href={provider.serviceUrl} target="_blank" rel="noopener noreferrer" class="btn btn-lift service-cta">
                  サービス詳細を見る
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17L17 7M7 7h10v10" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        </>
      )
    }
  </div>
</Base>

<style>
  /* 背景/枠線/角丸は共通の .card(global.css)に集約済み。ここは
     このカード固有の2カラムレイアウトだけを持つ。 */
  .service-card {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 1.6rem;
    padding: 1.4rem;
  }

  @media (max-width: 620px) {
    .service-card {
      grid-template-columns: 1fr;
    }
  }

  .service-image {
    aspect-ratio: 1;
    width: 100%;
    border-radius: 14px;
    object-fit: cover;
  }

  .service-image-empty {
    background-color: var(--color-panel);
  }

  .service-name {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 400;
    margin: 0 0 0.5em;
  }

  .service-desc {
    max-width: 46ch;
    font-size: 13.5px;
    line-height: 1.85;
    color: var(--color-meta);
  }

  /* 背景/枠線/角丸/ホバーの浮き上がりは共通の .btn.btn-lift(global.css)に
     集約済み。ここはこのボタン固有のフォントサイズと矢印アイコン演出だけを持つ。 */
  .service-cta {
    margin-top: 1.2rem;
    font-size: 13px;
  }

  .service-cta svg {
    width: 12px;
    height: 12px;
    color: var(--color-accent);
    transition: transform 0.25s ease;
  }

  .service-cta:hover svg,
  .service-cta:focus-visible svg {
    transform: translate(2px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .service-cta svg {
      transition: none;
    }
  }
</style>
