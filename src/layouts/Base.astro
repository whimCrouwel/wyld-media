---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import SiteHeader from '../components/organisms/SiteHeader.astro';
import NavDrawer from '../components/organisms/NavDrawer.astro';
import MobileTabBar from '../components/organisms/MobileTabBar.astro';
import SearchModal from '../components/organisms/SearchModal.astro';
import AnnouncementModal from '../components/organisms/AnnouncementModal.astro';
import BgGrid from '../components/organisms/BgGrid.astro';
import MetaLabel from '../components/atoms/MetaLabel.astro';
import type { AreaLink } from '../lib/sidebar';
import { organizationSchema, webSiteSchema } from '../lib/schema';
import JsonLd from '../components/JsonLd.astro';

export interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  articlePublishedTime?: string | null;
  articleModifiedTime?: string | null;
  articleAuthor?: string;
  activeAreaSlug?: string;
  padMain?: boolean;
  /* サイドバーの地図を「このページ内の絞り込み」として使うページ(ライター
     一覧・プロバイダー一覧など)だけ渡す。省略時は通常の記事ブラウズ用地図のまま。 */
  areaMode?: 'browse' | 'filter';
  areaLinks?: AreaLink[];
  /* areaMode="filter" のときの見出し文言。省略時は NavDrawer 側のデフォルト
     (ライター一覧向け)のまま。 */
  areaFilterLabel?: { en: string; ja: string };
}
// SiteHeader は fixed なので、本文はヘッダーぶんの頭上余白(pt-32)を持たないと
// 隠れる。full スロットを持つページ(トップ)は Hero 側で既にその余白を確保して
// いるので、full スロットが無いページでだけ本文に足す。
//
// デフォルト値は Astro.slots.has('full') から推測しているが、これはテンプレートの
// ソースに slot="full" という記述があるかどうかを見ているだけで、実行時にその分岐が
// real に通ったかどうかは見ていない(テンプレート内条件分岐)。呼び出し側が
// `{cond && <Fragment slot="full">...}` のように full スロットを条件付きで出し分けて
// いると、cond が false でも true 判定になってしまう。そのため full スロットを条件分岐
// するページ(トップ)は、必ず padMain を明示的に渡すこと。
//
// ヘッダークリアランスの所有者はここ(Base)だけにする。ページ側は自前で pt-32 を
// 足さない。カバーバナーのように本文冒頭がフルブリードでクリアランス不要なページは
// padMain={false} を渡す。検索・地域ナビはサイドバーを廃して NavDrawer に収めたので、
// 本文は常に全幅の1カラム。
const {
  title,
  description,
  canonicalPath,
  ogImage,
  ogType = 'website',
  noindex = false,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  activeAreaSlug,
  padMain = !Astro.slots.has('full'),
  areaMode,
  areaLinks,
  areaFilterLabel,
} = Astro.props;

if (!Astro.site) {
  throw new Error('Base: Astro.site is undefined. Set `site` in astro.config.mjs.');
}
const siteUrl = Astro.site.href;
const siteName = 'Wild Media';
const orgSchema = organizationSchema({ name: siteName, url: siteUrl });
const siteSchema = webSiteSchema({ name: siteName, url: siteUrl, inLanguage: 'ja' });
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      articlePublishedTime={articlePublishedTime}
      articleModifiedTime={articleModifiedTime}
      articleAuthor={articleAuthor}
    />
    <slot name="head" />
    <JsonLd data={orgSchema} />
    <JsonLd data={siteSchema} />
    <!-- keep any existing font/style links below this line -->
  </head>
  <body>
    {/* #bg-grid は .app-shell の外(body直下)に置くこと。将来 .app-shell や
        #page-shift に transform/filter 等を足すと position:fixed の包含ブロックが
        viewport ではなくそちらになり、スクロールで画面外へ流れてしまう。全ページで
        常時表示する共通背景なので、ページ側の slot="full" ではなくここで一度だけ
        描画する。 */}
    <BgGrid />
    {/* NavDrawer(常設サイドバー)と本文(#page-shift)を同じ flex 行に並べる
        (claude.ai のサイドバーと同じ構成)。NavDrawer の width が変わるだけで
        #page-shift は flex: 1 の兄弟として自動的に幅が変わる。旧実装は
        #page-shift 側に transform: translateX() を掛けて「本文を押し出す」演出を
        していたが、それだと本文の見た目の幅そのものは変わらず画面外へクリップ
        されていた。 */}
    <div class="app-shell">
      <NavDrawer
        activeAreaSlug={activeAreaSlug}
        areaMode={areaMode}
        areaLinks={areaLinks}
        areaFilterLabel={areaFilterLabel}
      />
      <div id="page-shift" class="page-shift">
        <SiteHeader />
        <!-- 本文の外側に出したいもの(トップの Hero など)。無いページでは何も出ない -->
        <slot name="full" />
        <main class={padMain ? 'pt-32' : ''}><slot /></main>
        <footer class="footer-row px-6 pb-10">
          <MetaLabel>Wild Media</MetaLabel>
          <div class="footer-right">
            <a href="/privacy" class="footer-link"><MetaLabel class="footer-link-label">Privacy</MetaLabel></a>
            <MetaLabel class="footer-copyright">&copy; {new Date().getFullYear()} Wild Card</MetaLabel>
          </div>
        </footer>
      </div>
    </div>
    <MobileTabBar />
    <SearchModal />
    <AnnouncementModal />
  </body>
</html>

<style>
  .app-shell {
    display: flex;
    min-height: 100dvh;
  }

  .page-shift {
    flex: 1 1 auto;
    min-width: 0;
  }

  /* 下部タブバー(MobileTabBar.astro、高さ約3.2rem+セーフエリア)に本文や
     フッターが隠れないようにする。 */
  @media (max-width: 767px) {
    .page-shift {
      padding-bottom: calc(2.5rem + env(safe-area-inset-bottom, 0px));
    }
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .footer-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-link {
    display: flex;
    align-items: center;
  }

  .footer-link-label {
    color: var(--color-meta);
    transition: color 0.2s ease;
  }

  .footer-link:hover :global(.footer-link-label) {
    color: var(--color-accent);
  }

  .footer-copyright {
    color: var(--color-meta);
  }
</style>
