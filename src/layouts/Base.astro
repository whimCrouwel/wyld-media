---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">Wild Media</a> | <a href="/writers">ライター一覧</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>Wild Media — ライターと環境のためのプラットフォーム</p>
    </footer>
  </body>
</html>
