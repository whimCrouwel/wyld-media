---
import AreaNav from '../molecules/AreaNav.astro';
import SearchTrigger from '../molecules/SearchTrigger.astro';
import MetaLabel from '../atoms/MetaLabel.astro';
import { supabaseServer } from '../../lib/supabase-server';
import { getAreaLinks } from '../../lib/sidebar';

interface Props {
  activeAreaSlug?: string;
}
const { activeAreaSlug } = Astro.props;

// ページ側から props で渡さない。ビルド中1回だけ実行されてメモ化される。
const areas = await getAreaLinks(supabaseServer);
---

{/* 常設サイドバー(claude.ai のサイドバーと同じ「押し出し式」)。デフォルトで
    開いている。#page-shift は Base.astro で .app-shell の flex 兄弟にしてあるので、
    ここの width が変わるだけで本文側は自動的に幅が変わる(position:fixed +
    transform で本文をずらす旧方式だと、本文の見た目の幅そのものは変わらず
    画面外へクリップされていた)。モーダルではなく常設レイアウトの一部なので
    inert やスクロールロックは掛けない。閉じるとロゴ等は隠れ、トグルボタンだけが
    残る細い帯(rail)になる(再度開く手段を残すため)。 */}
<aside id="nav-drawer" class="nav-drawer" aria-label="メニュー" data-lenis-prevent>
  <div class="nav-drawer-inner">
    <div class="nav-drawer-head">
      <a href="/" class="logo-link">
        <img src="/logo.svg" alt="Wild Media" class="logo-mark" />
      </a>
      <button type="button" id="nav-toggle" class="nav-toggle" aria-label="メニューを閉じる" aria-expanded="true">
        <svg
          class="nav-toggle-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="3" width="18" height="18" rx="3" />
          <line x1="9" y1="3" x2="9" y2="21" />
        </svg>
      </button>
    </div>

    <div class="nav-drawer-body">
      <SearchTrigger />
      <hr class="panel-rule" />
      <MetaLabel class="text-ink">Area</MetaLabel>
      <div class="mt-3">
        <AreaNav areas={areas} activeSlug={activeAreaSlug} />
      </div>
    </div>
  </div>
</aside>

<script>
  import '../../scripts/nav-drawer';
</script>

<style>
  /* 常設の押し出しパネル。閉じると rail 幅まで縮む(0にはしない。トグル
     ボタンの再アクセスを残すため)。幅は global.css の --nav-drawer-width /
     --nav-drawer-rail-width。 */
  .nav-drawer {
    position: sticky;
    top: 0;
    /* SiteHeader が position:fixed で画面幅いっぱいに広がっているため、
       それより手前(z-index を高く)にしないとトグルボタンがクリックを奪われる。 */
    z-index: 60;
    height: 100dvh;
    width: var(--nav-drawer-width);
    flex-shrink: 0;
    overflow: hidden;
    background-color: color-mix(in srgb, var(--color-ink) 7%, var(--color-bg));
    color: var(--color-ink);
    transition: width 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  html.drawer-closed .nav-drawer {
    width: var(--nav-drawer-rail-width);
  }

  .nav-drawer-inner {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.1rem 1rem 1.5rem;
  }

  .nav-drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .logo-link {
    display: flex;
    align-items: center;
    min-width: 0;
    overflow: hidden;
  }

  .logo-mark {
    height: 18px;
    width: auto;
    display: block;
  }

  .nav-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border: none;
    border-radius: 50%;
    background-color: transparent;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .nav-toggle:hover {
    background-color: color-mix(in srgb, var(--color-ink) 8%, transparent);
  }

  .nav-toggle-icon {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--color-meta);
    transition: color 0.2s ease;
  }

  .nav-toggle:hover .nav-toggle-icon {
    color: var(--color-ink);
  }

  /* rail 状態(閉時)ではロゴと本文一式を隠し、トグルボタンだけの帯にする */
  html.drawer-closed .logo-link,
  html.drawer-closed .nav-drawer-body {
    display: none;
  }

  .panel-rule {
    margin: 0.875rem 0;
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .nav-drawer-inner button {
    cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-drawer {
      transition: none;
    }
  }
</style>
