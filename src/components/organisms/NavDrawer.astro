---
import AreaNav from '../molecules/AreaNav.astro';
import MetaLabel from '../atoms/MetaLabel.astro';
import { supabaseServer } from '../../lib/supabase-server';
import { getAreaLinks, type AreaLink } from '../../lib/sidebar';

interface Props {
  activeAreaSlug?: string;
  /* 既定(browse): 記事件数の地域リンク集をビルド時に1回だけ取得して使い回す。
     ライター一覧・プロバイダー一覧など、地図を「このページ内の絞り込み」として
     使いたい場合だけ areaMode/areaLinks を明示的に渡して上書きする。 */
  areaMode?: 'browse' | 'filter';
  areaLinks?: AreaLink[];
  /* filter モード時の見出し文言。何を絞り込んでいるかはページごとに違うので
     呼び出し側から渡す(未指定ならライター一覧向けの文言のまま)。 */
  areaFilterLabel?: { en: string; ja: string };
}
const {
  activeAreaSlug,
  areaMode = 'browse',
  areaLinks,
  areaFilterLabel = { en: 'Writers per Area', ja: '地域でライターを絞り込む' },
} = Astro.props;

// ページ側から props で渡さない。ビルド中1回だけ実行されてメモ化される。
const areas = areaLinks ?? (await getAreaLinks(supabaseServer));
---

{/* 常設サイドバー(claude.ai のサイドバーと同じ「押し出し式」)。デフォルトで
    開いている。#page-shift は Base.astro で .app-shell の flex 兄弟にしてあるので、
    ここの width が変わるだけで本文側は自動的に幅が変わる(position:fixed +
    transform で本文をずらす旧方式だと、本文の見た目の幅そのものは変わらず
    画面外へクリップされていた)。モーダルではなく常設レイアウトの一部なので
    inert やスクロールロックは掛けない。閉じるとロゴ等は隠れ、トグルボタンだけが
    残る細い帯(rail)になる(再度開く手段を残すため)。
    デスクトップの検索導線は「記事を検索」の帯UIをやめ、開閉トグル(スライド
    アイコン)の真下に検索アイコンボタンを1個だけ並べる形にした
    (search-open-trigger は search-modal.ts が拾う共有クラス)。rail(閉時)
    でもこの2つのアイコンは隠さない — 折りたたんだままでも検索だけは開ける。
    768px 未満(モバイル)では別の見た目になる: この <aside> 自体を画面下から
    せり上がるシートに変え、下部タブバー(MobileTabBar.astro)の Area ボタン
    (id="area-sheet-open")で開閉する。検索も同タブバー側の検索ボタンに
    任せるため、この <aside> 内の頭部(ロゴ・トグル・検索アイコン列)は
    モバイルでは丸ごと非表示にする。お知らせバナーも同様に、モバイルでは
    タブバーの News ボタンから直接モーダルを開く導線に切り出したので、
    この地図シート内では非表示にする(announcement-banner.ts 参照)。 */}
<div id="area-sheet-backdrop" class="area-sheet-backdrop" data-lenis-prevent></div>
<aside id="nav-drawer" class="nav-drawer" aria-label="メニュー" data-lenis-prevent>
  <div class="nav-drawer-inner">
    <div class="sheet-handle" aria-hidden="true"></div>

    <div class="nav-drawer-head">
      <a href="/" class="logo-link">
        <img src="/logo.svg" alt="Wild Media" class="logo-mark" />
      </a>
      <div class="nav-head-actions">
        <button type="button" class="nav-toggle search-open-trigger nav-search-toggle" aria-label="記事を検索">
          <svg
            class="nav-toggle-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </button>
        <button type="button" id="nav-toggle" class="nav-toggle" aria-label="メニューを閉じる" aria-expanded="true">
          <svg
            class="nav-toggle-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="3" />
            <line x1="9" y1="3" x2="9" y2="21" />
          </svg>
        </button>
      </div>
    </div>

    <div class="nav-drawer-body">
      <div id="announcement-banner" class="announcement-banner" hidden data-lenis-prevent>
        <button type="button" id="announcement-banner-open" class="announcement-banner-open">
          <span class="announcement-banner-label">
            <span class="announcement-banner-dot" aria-hidden="true"></span>
            News
            <span class="announcement-banner-label-ja">お知らせ</span>
          </span>
          <span id="announcement-banner-title" class="announcement-banner-title"></span>
          <span class="announcement-banner-more" aria-hidden="true">詳しく読む →</span>
        </button>
      </div>
      <MetaLabel class="area-heading-en">{areaMode === 'filter' ? areaFilterLabel.en : 'Articles per Area'}</MetaLabel>
      <span class="area-heading-ja">
        {areaMode === 'filter' ? areaFilterLabel.ja : '地域から記事を探す'}
      </span>
      <div class="mt-3">
        <AreaNav areas={areas} activeSlug={activeAreaSlug} mode={areaMode} />
      </div>
    </div>
  </div>
</aside>

<script>
  import '../../scripts/nav-drawer';
  import '../../scripts/area-sheet';
  import '../../scripts/announcement-banner';
</script>

<style>
  /* 常設の押し出しパネル。閉じると rail 幅まで縮む(0にはしない。トグル
     ボタンの再アクセスを残すため)。幅は global.css の --nav-drawer-width /
     --nav-drawer-rail-width。背景は --color-ink(黒)にして本文と明確に分離し、
     内側の文字・罫線・ロゴは反転させて黒地の上で読めるようにしている。 */
  .nav-drawer {
    position: sticky;
    top: 0;
    /* SiteHeader が position:fixed で画面幅いっぱいに広がっているため、
       それより手前(z-index を高く)にしないとトグルボタンがクリックを奪われる。 */
    z-index: 60;
    height: 100dvh;
    width: var(--nav-drawer-width);
    flex-shrink: 0;
    overflow: hidden;
    background-color: var(--color-ink);
    color: var(--color-bg);
    transition: width 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  html.drawer-closed .nav-drawer {
    width: var(--nav-drawer-rail-width);
  }

  .nav-drawer-inner {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.1rem 0.85rem 1.5rem;
  }

  .nav-drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  /* .meta(global.css)がレイヤー外の生CSSで color を直接指定しているため、
     Tailwind の text-accent ユーティリティ(@layer utilities 内)は詳細度・
     ソース順に関わらず負ける。同じくレイヤー外のセレクタとして書き、
     詳細度を上げて確実に上書きする。 */
  :global(.nav-drawer-body .area-heading-en) {
    color: var(--color-accent);
  }

  /* 英語ラベル(MetaLabel)の下に添える日本語の小さな補足。letter-spacing や
     uppercase は英語チップ用の意匠なので継承させない。 */
  .area-heading-ja {
    display: block;
    margin-top: 2px;
    font-size: 10px;
    line-height: 1.3;
    color: var(--color-meta);
    opacity: 0.85;
  }

  .nav-head-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .logo-link {
    display: flex;
    align-items: center;
    min-width: 0;
    overflow: hidden;
  }

  .logo-mark {
    height: 14px;
    width: auto;
    display: block;
    /* ロゴSVGは濃色(#231f20)固定塗りのため、黒地の上では反転させて生成り色に見せる */
    filter: invert(1);
  }

  .nav-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border: none;
    border-radius: 50%;
    background-color: transparent;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .nav-toggle:hover {
    background-color: color-mix(in srgb, var(--color-bg) 12%, transparent);
  }

  .nav-toggle-icon {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--color-meta);
    transition: color 0.2s ease;
  }

  .nav-toggle:hover .nav-toggle-icon {
    color: var(--color-bg);
  }

  /* rail 状態(閉時)ではロゴ・検索アイコン・本文一式を隠し、トグルボタンだけの
     帯にする(検索は開いているときだけの導線にする)。 */
  html.drawer-closed .logo-link,
  html.drawer-closed .nav-search-toggle,
  html.drawer-closed .nav-drawer-body {
    display: none;
  }

  .nav-drawer-inner button {
    cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-drawer {
      transition: none;
    }
  }

  /* お知らせバナー。閉じる操作は無く、公開中のお知らせがある間は出続ける。
     黒地の上でアクセント色を効かせたカード型で、全面がモーダルを開くボタン。 */
  .announcement-banner {
    margin-bottom: 1.1rem;
  }

  .announcement-banner-open {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.7rem 0.75rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    border-radius: 12px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-accent) 24%, transparent),
      color-mix(in srgb, var(--color-accent) 8%, transparent)
    );
    color: var(--color-bg);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .announcement-banner-open:hover {
    border-color: var(--color-accent);
  }

  .announcement-banner-label {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-accent);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .announcement-banner-label-ja {
    font-family: var(--font-sans);
    letter-spacing: 0.08em;
    color: var(--color-meta);
  }

  .announcement-banner-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent);
    animation: announcement-pulse 2.4s ease-out infinite;
  }

  @keyframes announcement-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-accent) 55%, transparent);
    }
    70% {
      box-shadow: 0 0 0 5px transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-banner-dot {
      animation: none;
    }
  }

  .announcement-banner-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin-top: 0.35rem;
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.45;
  }

  .announcement-banner-more {
    display: block;
    margin-top: 0.4rem;
    font-size: 10px;
    color: color-mix(in srgb, var(--color-bg) 65%, transparent);
  }

  html.drawer-closed .announcement-banner {
    display: none;
  }

  .area-sheet-backdrop {
    display: none;
  }

  .sheet-handle {
    display: none;
  }

  /* モバイル: 常設サイドバーではなく、地図アイコンで開閉する下からのシートにする。
     rail(閉時に幅だけ残す)の概念は無し。既定は非表示(translateY(100%))で、
     html.area-sheet-open が付いたときだけ迫り上がる。 */
  @media (max-width: 767px) {
    .nav-drawer {
      position: fixed;
      inset: auto auto 0 50%;
      top: auto;
      z-index: 70;
      width: 100%;
      max-width: 26rem;
      height: auto;
      /* dvh や min() を解釈できないブラウザ(古い Android WebView・アプリ内
         ブラウザ等)ではその行だけ丸ごと無効になり max-height が外れて
         シートが正しく収まらなくなる。先に vh 版を書いて確実に効かせておき、
         対応ブラウザでは後段の dvh 版で上書き(アドレスバー分を除いた
         高さで計算)させる段階的フォールバックにする。 */
      max-height: min(80vh, 640px);
      max-height: min(80dvh, 640px);
      border-radius: 20px 20px 0 0;
      transform: translate(-50%, 100%);
      transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
      box-shadow: 0 -12px 32px rgba(0, 0, 0, 0.3);
    }

    html.area-sheet-open .nav-drawer {
      transform: translate(-50%, 0);
    }

    .nav-drawer-inner {
      max-height: min(80vh, 640px);
      max-height: min(80dvh, 640px);
      padding: 0.6rem 1.1rem 1.5rem;
    }

    /* デスクトップの rail 用ロゴ・トグルは出さない。シートの開閉は
       モバイルヘッダーの地図アイコン(#area-sheet-open)とバックドロップが担う。 */
    .nav-drawer-head {
      display: none;
    }

    /* お知らせはモバイルでは下部タブバーの News ボタンから直接モーダルを開く
       導線に切り出したので、地図シート側には表示しない(マップに紛れ込む
       問題の解消)。 */
    .announcement-banner {
      display: none;
    }

    .sheet-handle {
      display: block;
      width: 2.5rem;
      height: 4px;
      margin: 0 auto 0.75rem;
      border-radius: 999px;
      background-color: color-mix(in srgb, var(--color-bg) 25%, transparent);
    }

    .area-sheet-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 65;
      background-color: rgba(20, 20, 19, 0.45);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.32s ease;
    }

    html.area-sheet-open .area-sheet-backdrop {
      opacity: 1;
      pointer-events: auto;
    }
  }

  @media (max-width: 767px) and (prefers-reduced-motion: reduce) {
    .nav-drawer,
    .area-sheet-backdrop {
      transition: none;
    }
  }
</style>
