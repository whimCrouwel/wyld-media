---
import SectionHeader from '../molecules/SectionHeader.astro';

// トップページの「保存した記事」カルーセル(案1: Featured と記事リストの間)。
// 読者がこのブラウザで保存した公開記事を、カバー画像主役の横スクロール帯で出す。
// 中身は saved-carousel.ts が実行時に localStorage → bookmarked_articles RPC で描画。
// 保存が無ければセクションごと非表示(hidden のまま)。小さい画面ではスワイプで送る。
---

<section id="saved-carousel" class="pb-16" hidden>
  <SectionHeader label="Saved" count="" countId="saved-carousel-count" class="mx-6 pb-1" />
  <p class="area-heading-ja text-meta mx-6 pb-5">保存した記事</p>
  <div class="saved-carousel-track">
    <ol id="saved-carousel-list" class="saved-carousel-inner"></ol>
  </div>
</section>

<script>
  import '../../scripts/saved-carousel';
</script>

<style>
  .area-heading-ja {
    font-size: 11px;
    letter-spacing: 0.02em;
  }
  /* 横スクロール帯。ネイティブスクロール + スナップでモバイルはスワイプ、
     デスクトップはトラックパッド/ホイールで送れる。左右の余白は px-6 に合わせる。 */
  .saved-carousel-track {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }
  .saved-carousel-inner {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0 1.5rem 0.75rem;
  }
  /* 幅の制御は flex アイテムである <li> に置く(.saved-card に置くと
     flex コンテナの直接の子ではないため効かず、空カバーのカードが潰れる)。 */
  :global(.saved-carousel-inner > li) {
    flex: 0 0 62vw;
    max-width: 320px;
    scroll-snap-align: start;
  }
  @media (min-width: 640px) {
    :global(.saved-carousel-inner > li) { flex-basis: 38vw; }
  }
  @media (min-width: 1024px) {
    :global(.saved-carousel-inner > li) { flex-basis: 23vw; }
  }
  :global(.saved-card) {
    text-decoration: none;
    color: var(--color-ink);
    display: flex;
    flex-direction: column;
  }
  :global(.saved-card__cover) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background-color: var(--color-card);
    display: block;
  }
  :global(.saved-card__cover img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  :global(.saved-card:hover .saved-card__cover img) {
    transform: scale(1.03);
  }
  /* カバー未設定/読み込み失敗時のプレースホルダ(画像アイコン中央)。 */
  :global(.saved-card__cover--empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    color: color-mix(in srgb, var(--color-ink) 28%, transparent);
  }
  :global(.saved-card__title) {
    margin-top: 0.65rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.saved-card__cover img) { transition: none; }
    :global(.saved-card:hover .saved-card__cover img) { transform: none; }
  }
</style>
