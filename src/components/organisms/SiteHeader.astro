---
import MetaLabel from '../atoms/MetaLabel.astro';
import SocialIcon from '../atoms/SocialIcon.astro';

// 現在地のハイライト用。Writers/Changemakers はそれぞれ配下のプロフィールページも
// 含めて「現在地」とみなす。トップ(Works相当)へのリンクはロゴが兼ねているため
// ナビ項目としては持たない。
const pathname = Astro.url.pathname;
const isWritersActive = pathname.startsWith('/writers');
const isChangemakersActive = pathname.startsWith('/providers');
---

{/* デスクトップ: ロゴとメニュー開閉ボタンは常設サイドバー(NavDrawer.astro)側に
    あるので、ここはライター一覧・認定プロバイダー一覧への直接リンクだけ
    (justify-end)。トップへの導線はロゴが兼ねるため、Works的なリンクは置かない。
    プロバイダー一覧へのリンクは表示文言だけ「Changemakers」にしている
    (リンク先は変わらず /providers。ロールとしては「provider」だが、単なる企業
    ディレクトリではなく環境活動そのものへの導線に見えるよう表示文言だけ変えた)。
    モバイル(768px未満): ロゴ + ハンバーガーボタンだけを出す。
    Writers/Changemakers はハンバーガーの先にある小さなドロップダウン
    (#mobile-menu)に格納する。検索・地域(地図シート開閉)はここには置かず、
    画面下部の MobileTabBar.astro(アプリのタブバー)に移した。
    地色(--color-bg)を上から下へのグラデーションで乗せているのは、writers/providers
    のカバー画像の上に重なっても文字が読めるようにするため(完全透明だと写真に
    よっては文字が埋もれる)。ヘッダー下端で完全透明に落とし、その下のカバー画像
    との境目が硬い帯にならず馴染むようにする。 */}
<header
  class="fixed top-0 right-0 left-0 z-50 flex items-center justify-between gap-4 px-6 py-5 md:justify-end"
  style="background: linear-gradient(to bottom, color-mix(in srgb, var(--color-bg) 88%, transparent) 0%, transparent 100%);"
>
  <a href="/" class="logo-link-mobile flex items-center md:hidden">
    <img src="/logo.svg" alt="Wild Media" class="logo-mark-mobile" />
  </a>

  <nav class="hidden items-center gap-6 md:flex">
    <a href="/writers" class:list={['nav-link', { 'is-active': isWritersActive }]}
      ><MetaLabel class="nav-link-label">Writers</MetaLabel></a
    >
    <a href="/providers" class:list={['nav-link', { 'is-active': isChangemakersActive }]}
      ><MetaLabel class="nav-link-label">Changemakers</MetaLabel></a
    >
    {/* Wild Media公式Instagramへの導線。ヘッダーの文字色(--color-ink)と
        同じ丸背景+白(--color-bg)アイコン。デスクトップのみ。 */}
    <a
      href="https://www.instagram.com/wild_card_jp"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram"
      class="header-sns"
    >
      <SocialIcon platform="instagram" class="text-bg h-[14px] w-[14px]" />
    </a>
  </nav>

  <button
    type="button"
    id="mobile-menu-toggle"
    class="icon-btn flex md:hidden"
    aria-label="メニュー"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
      <line x1="4" y1="7" x2="20" y2="7" />
      <line x1="4" y1="12" x2="20" y2="12" />
      <line x1="4" y1="17" x2="20" y2="17" />
    </svg>
  </button>
</header>

<nav id="mobile-menu" class="mobile-menu md:hidden" aria-label="メニュー">
  <a href="/writers" class:list={['mobile-menu-link', { 'is-active': isWritersActive }]}
    ><MetaLabel class="nav-link-label">Writers</MetaLabel></a
  >
  <a href="/providers" class:list={['mobile-menu-link', { 'is-active': isChangemakersActive }]}
    ><MetaLabel class="nav-link-label">Changemakers</MetaLabel></a
  >
</nav>

<script>
  import '../../scripts/mobile-menu';
</script>

<style>
  /* Writers/Changemakers 共通のテキスト色。ホバー/現在地はどちらも差し色
     (--color-accent)で揃え、現在地はさらに下線で区別する(サイドバーの
     地域チップ .chip.is-active と同じ言語)。MetaLabel の span は別ファイルの
     コンポーネントでこのスコープIDを持たないため :global() で届かせる
     (LoadMore.astro の .load-more-label と同じ手当て)。 */
  .nav-link-label {
    color: var(--color-ink);
    transition: color 0.2s ease;
  }

  .nav-link:hover :global(.nav-link-label) {
    color: var(--color-accent);
  }

  .nav-link.is-active :global(.nav-link-label) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .logo-mark-mobile {
    height: 16px;
    width: auto;
    display: block;
  }

  .icon-btn {
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border: none;
    border-radius: 50%;
    background-color: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .icon-btn:hover,
  .icon-btn:focus-visible {
    background-color: color-mix(in srgb, var(--color-ink) 8%, transparent);
  }

  /* Works/Writers と同じ行に置く公式Instagram導線。ヘッダーの文字色
     (--color-ink)と同じ丸背景+白(--color-bg)アイコン。 */
  .header-sns {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background-color: var(--color-ink);
    transition: opacity 0.2s ease;
  }

  .header-sns:hover {
    opacity: 0.8;
  }

  .icon-btn svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 767px) {
    /* ハンバーガーの右下に出るドロップダウンカード。閉時は少し上・透明で
       浮いた状態にし、開くと定位置へフェードイン(シートのような大きな
       オーバーレイにはしない — Writers/Changemakers の2本だけなので軽い演出で十分)。 */
    .mobile-menu {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      position: fixed;
      top: 4.25rem;
      right: 1.5rem;
      z-index: 55;
      min-width: 9rem;
      padding: 1rem 1.25rem;
      border-radius: 16px;
      background-color: var(--color-bg);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
      opacity: 0;
      transform: translateY(-8px);
      pointer-events: none;
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
    }

    html.mobile-menu-open .mobile-menu {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .mobile-menu-link:hover :global(.nav-link-label) {
      color: var(--color-accent);
    }

    .mobile-menu-link.is-active :global(.nav-link-label) {
      color: var(--color-accent);
      text-decoration: underline;
      text-underline-offset: 5px;
    }
  }

  @media (max-width: 767px) and (prefers-reduced-motion: reduce) {
    .mobile-menu {
      transition: none;
    }
  }
</style>
