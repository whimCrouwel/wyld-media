---
import MetaLabel from '../atoms/MetaLabel.astro';
import SocialIcon from '../atoms/SocialIcon.astro';
---

{/* デスクトップ: ロゴとメニュー開閉ボタンは常設サイドバー(NavDrawer.astro)側に
    あるので、ここは記事一覧・ライター一覧・認定プロバイダー一覧への直接リンクだけ
    (justify-end)。プロバイダー一覧へのリンクは表示文言だけ「Projects」にしている
    (リンク先は変わらず /providers。ロールとしては「provider」だが、単なる企業
    ディレクトリではなく環境活動そのものへの導線に見えるよう表示文言だけ変えた)。
    モバイル(768px未満): ロゴ + ハンバーガーボタンだけを出す。
    Works/Writers/Projects はハンバーガーの先にある小さなドロップダウン
    (#mobile-menu)に格納する。検索・地域(地図シート開閉)はここには置かず、
    画面下部の MobileTabBar.astro(アプリのタブバー)に移した。 */}
<header class="fixed top-0 right-0 left-0 z-50 flex items-center justify-between gap-4 px-6 py-5 md:justify-end">
  <a href="/" class="logo-link-mobile flex items-center md:hidden">
    <img src="/logo.svg" alt="Wild Media" class="logo-mark-mobile" />
  </a>

  <nav class="hidden items-center gap-6 md:flex">
    <a href="/" class="transition-opacity hover:opacity-60"><MetaLabel class="text-ink">Works</MetaLabel></a>
    <a href="/writers" class="transition-opacity hover:opacity-60"
      ><MetaLabel class="text-ink">Writers</MetaLabel></a
    >
    <a href="/providers" class="transition-opacity hover:opacity-60"
      ><MetaLabel class="text-ink">Projects</MetaLabel></a
    >
    {/* Wild Media公式Instagramへの導線。ヘッダーの文字色(--color-ink)と
        同じ丸背景+白(--color-bg)アイコン。デスクトップのみ。 */}
    <a
      href="https://www.instagram.com/wild_card_jp"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram"
      class="header-sns"
    >
      <SocialIcon platform="instagram" class="text-bg h-[14px] w-[14px]" />
    </a>
  </nav>

  <button
    type="button"
    id="mobile-menu-toggle"
    class="icon-btn flex md:hidden"
    aria-label="メニュー"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
      <line x1="4" y1="7" x2="20" y2="7" />
      <line x1="4" y1="12" x2="20" y2="12" />
      <line x1="4" y1="17" x2="20" y2="17" />
    </svg>
  </button>
</header>

<nav id="mobile-menu" class="mobile-menu md:hidden" aria-label="メニュー">
  <a href="/" class="mobile-menu-link"><MetaLabel class="text-ink">Works</MetaLabel></a>
  <a href="/writers" class="mobile-menu-link"><MetaLabel class="text-ink">Writers</MetaLabel></a>
  <a href="/providers" class="mobile-menu-link"><MetaLabel class="text-ink">Projects</MetaLabel></a>
</nav>

<script>
  import '../../scripts/mobile-menu';
</script>

<style>
  .logo-mark-mobile {
    height: 16px;
    width: auto;
    display: block;
  }

  .icon-btn {
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border: none;
    border-radius: 50%;
    background-color: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .icon-btn:hover,
  .icon-btn:focus-visible {
    background-color: color-mix(in srgb, var(--color-ink) 8%, transparent);
  }

  /* Works/Writers と同じ行に置く公式Instagram導線。ヘッダーの文字色
     (--color-ink)と同じ丸背景+白(--color-bg)アイコン。 */
  .header-sns {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background-color: var(--color-ink);
    transition: opacity 0.2s ease;
  }

  .header-sns:hover {
    opacity: 0.8;
  }

  .icon-btn svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 767px) {
    /* ハンバーガーの右下に出るドロップダウンカード。閉時は少し上・透明で
       浮いた状態にし、開くと定位置へフェードイン(シートのような大きな
       オーバーレイにはしない — Works/Writers/Projects の3本だけなので軽い演出で十分)。 */
    .mobile-menu {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      position: fixed;
      top: 4.25rem;
      right: 1.5rem;
      z-index: 55;
      min-width: 9rem;
      padding: 1rem 1.25rem;
      border-radius: 16px;
      background-color: var(--color-bg);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
      opacity: 0;
      transform: translateY(-8px);
      pointer-events: none;
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
    }

    html.mobile-menu-open .mobile-menu {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .mobile-menu-link {
      transition: opacity 0.2s ease;
    }

    .mobile-menu-link:hover {
      opacity: 0.6;
    }
  }

  @media (max-width: 767px) and (prefers-reduced-motion: reduce) {
    .mobile-menu {
      transition: none;
    }
  }
</style>
