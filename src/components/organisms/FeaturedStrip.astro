---
import SpecimenCard from '../molecules/SpecimenCard.astro';
import SectionHeader from '../molecules/SectionHeader.astro';
import type { GalleryWork } from '../../lib/images';

interface Props {
  works: GalleryWork[];
}
const { works } = Astro.props;
---

{
  works.length > 0 && (
    <section class="pb-16">
      <SectionHeader label="Featured" count={works.length} class="mx-6 pb-6" />
      <div id="featured-strip" class="cursor-grab overflow-hidden px-6 active:cursor-grabbing">
        <div class="flex gap-6">
          {works.map((work) => (
            <SpecimenCard
              href={work.href}
              title={work.title}
              date={work.date}
              imageUrl={work.imageUrl}
              ratio={16 / 9}
              number={work.number}
              authorName={work.authorName}
              authorHref={work.authorHref}
              authorAvatarUrl={work.authorAvatarUrl}
              class="reveal group w-[85vw] shrink-0 sm:w-[60vw] lg:w-[45vw]"
              data-featured-card
            />
          ))}
        </div>
      </div>
    </section>
  )
}
