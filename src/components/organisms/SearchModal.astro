---
import MetaLabel from '../atoms/MetaLabel.astro';
---
<dialog id="search-modal" class="search-modal" aria-label="記事を検索">
  <!-- 閉じるボタンは絶対配置。行として置くと縦を40px以上使い、
       画面の低いノートPCで結果の表示領域を圧迫するため -->
  <form method="dialog" class="close-row">
    <button type="submit" aria-label="閉じる"><MetaLabel>Close ×</MetaLabel></button>
  </form>
  <!-- 入力を自前の form に入れる。dialog 内に method="dialog" の form が
       あると、form の外にある input で Enter を押したとき そちらが既定の
       送信先として働いてダイアログが閉じてしまう(検索は走るのに結果が
       見えない)。input に form 所有者を与えることで Enter がこの form の
       submit として届く。 -->
  <form id="search-form">
    <input
      type="search"
      id="search-input"
      placeholder="記事を検索"
      aria-label="記事を検索"
      class="search-input"
    />
  </form>
  <p role="status" class="mt-4"><MetaLabel id="search-status" /></p>
  <ul id="search-results" class="mt-6" hidden></ul>
</dialog>

<script>
  import '../../scripts/search-modal';
</script>

<style>
  /* 高さを画面内に収め、スクロールするのは結果リストだけにする。
     検索欄と状態表示は常に見えている必要があるため。 */
  .search-modal {
    position: relative;
    width: min(40rem, calc(100vw - 3rem));
    max-height: calc(100dvh - 4rem);
    margin: auto;
    padding: 1.5rem;
    border: none;
    border-radius: 20px;
    background-color: var(--color-bg);
    color: var(--color-ink);
  }

  .search-modal[open] {
    display: flex;
    flex-direction: column;
  }

  .close-row {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
  }

  .search-modal::backdrop {
    background-color: rgba(53, 48, 31, 0.4);
  }

  /* 検索欄・状態表示は結果が伸びても縮ませない */
  .search-modal > form,
  .search-modal > p {
    flex-shrink: 0;
  }

  .search-input {
    width: 100%;
    border: none;
    border-bottom: 1px solid var(--color-card);
    background: transparent;
    padding: 0.5rem 0;
    font-family: var(--font-heading);
    font-size: 22px;
    outline: none;
  }

  #search-results {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    /* basis は必ず auto にする。flex:1(=basis:0) だとリストの中身の高さが
       dialog(height:fit-content)の高さ計算に入らず、器が見出しぶんまで潰れて
       結果が1件も見えなくなる。auto なら中身ぶん伸び、max-height に当たった
       ところで min-height:0 により縮んでスクロールに切り替わる。 */
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain; /* 端まで来ても背後のページを巻き込まない */
    padding-bottom: 1.25rem;
    padding-right: 0.5rem; /* スクロールバーとカードの縁が触れないように */

    /* macOS の overlay scrollbar は普段隠れていて、スクロールできることが
       分からない。::-webkit-scrollbar を指定すると常時表示の従来型に変わる。
       標準プロパティの scrollbar-width / scrollbar-color は書かないこと。
       どちらか一方でも指定すると Chrome は ::-webkit-scrollbar を無視して
       overlay のままになり、幅も取らない。 */
  }

  #search-results::-webkit-scrollbar {
    width: 8px;
  }

  #search-results::-webkit-scrollbar-thumb {
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-ink) 25%, transparent);
  }

  #search-results::-webkit-scrollbar-thumb:hover {
    background-color: color-mix(in srgb, var(--color-ink) 45%, transparent);
  }

  /* 記事カード。ライター詳細ページの記事カードと同じ角丸+枠線の語彙に揃える */
  .search-modal :global(.result-card) {
    display: block;
    border: 1px solid var(--color-card);
    border-radius: 16px;
    padding: 0.9rem 1rem;
    transition: border-color 0.2s ease;
  }

  .search-modal :global(.result-card:hover),
  .search-modal :global(.result-card:focus-visible) {
    border-color: var(--color-ink);
  }

  .search-modal :global(.result-title) {
    display: block;
    font-family: var(--font-heading);
    font-size: 16px;
    line-height: 1.4;
  }

  /* ライター名 左・取材地 右。サイドバーの AREA と同じリズム */
  .search-modal :global(.result-byline) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.4rem;
  }

  .search-modal :global(.result-excerpt) {
    display: block;
    margin-top: 0.6rem;
    font-size: 13px;
    line-height: 1.8;
    color: var(--color-meta);
  }

  /* 一致語。PGroonga が <span class="keyword"> で返してくる。
     古紙の上に引いた色鉛筆の線に見えるよう、下半分だけを温かいオークルで塗る */
  .search-modal :global(.keyword) {
    color: var(--color-ink);
    box-shadow: inset 0 -0.42em 0 rgba(176, 137, 74, 0.35);
  }
</style>
