---
import MetaLabel from '../atoms/MetaLabel.astro';
---
<dialog id="search-modal" class="search-modal" aria-label="記事を検索">
  <form method="dialog" class="mb-6 flex justify-end">
    <button type="submit" aria-label="閉じる"><MetaLabel>Close ×</MetaLabel></button>
  </form>
  <input
    type="search"
    id="search-input"
    placeholder="記事を検索"
    aria-label="記事を検索"
    class="search-input"
  />
  <p role="status" class="mt-4"><MetaLabel id="search-status" /></p>
  <ul id="search-results" class="mt-6" hidden></ul>
</dialog>

<script>
  import '../../scripts/search-modal';
</script>

<style>
  /* 高さを画面内に収め、スクロールするのは結果リストだけにする。
     検索欄と状態表示は常に見えている必要があるため。 */
  .search-modal {
    width: min(40rem, calc(100vw - 3rem));
    max-height: calc(100dvh - 4rem);
    margin: auto;
    padding: 1.5rem;
    border: none;
    border-radius: 20px;
    background-color: var(--color-bg);
    color: var(--color-ink);
  }

  .search-modal[open] {
    display: flex;
    flex-direction: column;
  }

  .search-modal::backdrop {
    background-color: rgba(53, 48, 31, 0.4);
  }

  /* 検索欄・状態表示は結果が伸びても縮ませない */
  .search-modal > form,
  .search-modal > .search-input,
  .search-modal > p {
    flex-shrink: 0;
  }

  .search-input {
    width: 100%;
    border: none;
    border-bottom: 1px solid var(--color-card);
    background: transparent;
    padding: 0.5rem 0;
    font-family: var(--font-heading);
    font-size: 22px;
    outline: none;
  }

  /* 件数が多いとリスト内でスクロールする。macOS はスクロールバーが出ないので、
     下端をフェードさせて「まだ続きがある」ことを見せる(切れて壊れて見えないように) */
  #search-results {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    min-height: 0; /* flex 子要素は既定で縮まないので、これがないと溢れる */
    overflow-y: auto;
    overscroll-behavior: contain; /* 端まで来ても背後のページを巻き込まない */
    padding-bottom: 1.25rem;
  }

  /* まだ下に続きがある時だけフェードさせる(JS が data-more を付け外しする) */
  #search-results[data-more] {
    mask-image: linear-gradient(to bottom, #000 calc(100% - 1.75rem), transparent);
  }

  /* 記事カード。ライター詳細ページの記事カードと同じ角丸+枠線の語彙に揃える */
  .search-modal :global(.result-card) {
    display: block;
    border: 1px solid var(--color-card);
    border-radius: 16px;
    padding: 0.9rem 1rem;
    transition: border-color 0.2s ease;
  }

  .search-modal :global(.result-card:hover),
  .search-modal :global(.result-card:focus-visible) {
    border-color: var(--color-ink);
  }

  .search-modal :global(.result-title) {
    display: block;
    font-family: var(--font-heading);
    font-size: 16px;
    line-height: 1.4;
  }

  /* ライター名 左・取材地 右。サイドバーの AREA と同じリズム */
  .search-modal :global(.result-byline) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.4rem;
  }

  .search-modal :global(.result-excerpt) {
    display: block;
    margin-top: 0.6rem;
    font-size: 13px;
    line-height: 1.8;
    color: var(--color-meta);
  }

  /* 一致語。PGroonga が <span class="keyword"> で返してくる。
     古紙の上に引いた色鉛筆の線に見えるよう、下半分だけを温かいオークルで塗る */
  .search-modal :global(.keyword) {
    color: var(--color-ink);
    box-shadow: inset 0 -0.42em 0 rgba(176, 137, 74, 0.35);
  }
</style>
