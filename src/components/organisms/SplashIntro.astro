---
/*
 * 起動スプラッシュ。SEO・AI クローラ対策のため、初期 HTML には div を出さない。
 * JS が DOMContentLoaded 後にオーバーレイを注入する(実処理は src/scripts/splash.ts)。
 * JS 無効環境ではオーバーレイは一切現れない(コンテンツが即座に見える)。
 */
---

<script>
  import '../../scripts/splash';
</script>

<style is:global>
  #splash {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--color-bg, #faf9f5);
    will-change: opacity;
  }
  #splash canvas {
    display: block;
  }
  /* 地球の下に、結像したころ小さくフェードインするワードマーク。
     爆散時はオーバーレイ(#splash)ごとフェードするので退場は自動。 */
  .splash-word {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-accent, sans-serif);
    font-weight: 700;
    font-size: clamp(32px, 6vw, 76px);
    letter-spacing: 0.02em;
    color: var(--color-ink, #141413);
    white-space: nowrap;
    /* 最初から表示。退場は #splash オーバーレイのフェードに任せ、地球と同時に消す */
    opacity: 0.92;
  }
  @media (prefers-reduced-motion: reduce) {
    #splash {
      display: none;
    }
  }
</style>
