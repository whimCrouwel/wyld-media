---
import AreaNav from '../molecules/AreaNav.astro';
import SearchTrigger from '../molecules/SearchTrigger.astro';
import MetaLabel from '../atoms/MetaLabel.astro';
import { supabaseServer } from '../../lib/supabase-server';
import { getAreaLinks } from '../../lib/sidebar';

interface Props {
  activeAreaSlug?: string;
}
const { activeAreaSlug } = Astro.props;

// ページ側から props で渡さない。ビルド中1回だけ実行されてメモ化される。
const areas = await getAreaLinks(supabaseServer);
---
<aside class="px-6 pb-10 lg:pb-24" aria-label="サイドバー">
  <div class="sidebar-panel">
    <SearchTrigger />
    <hr class="panel-rule" />
    <MetaLabel class="text-ink">Area</MetaLabel>
    <div class="mt-3">
      <AreaNav areas={areas} activeSlug={activeAreaSlug} />
    </div>
  </div>
</aside>

<style>
  /* 「記事を探す」ための道具(キーワード検索と地図)を1枚の器にまとめる。
     別々のカードに分けると、同じ用途のものが2つの面に散る。
     地色はそのまま地図の「海」として働き、タイル(陸)と対比になる。

     幅について: 地図は5列 1fr なので、器が痩せるとタイルが44pxを割って
     「甲信越」などのラベルが窮屈になる。サイドバー列(Base.astro)を
     19rem にしてあるのは、px-6 のガターを保ったまま地図の実寸を
     確保するため。列幅を変えるときは地図のタイル幅も確認すること。 */
  .sidebar-panel {
    padding: 0.875rem 0.75rem 1rem;
    border-radius: 20px;
    background-color: color-mix(in srgb, var(--color-ink) 7%, var(--color-bg));
  }

  .panel-rule {
    margin: 0.875rem 0;
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }
</style>
