---
import SpecimenCard from './SpecimenCard.astro';

interface Props {
  href: string;
  title: string;
  date: string;
  imageUrl: string | null;
  ratio: number;
  number: number;
  authorName: string;
  authorHref: string;
  authorAvatarUrl: string | null;
  index: number;
}
const {
  href,
  title,
  date,
  imageUrl,
  ratio,
  number,
  authorName,
  authorHref,
  authorAvatarUrl,
  index,
} = Astro.props;
---

{/* グリッドのカード。masonry の並べ替え・reveal 用に data-ratio/data-index/reveal を足す。 */}
<SpecimenCard
  href={href}
  title={title}
  date={date}
  imageUrl={imageUrl}
  ratio={ratio}
  number={number}
  authorName={authorName}
  authorHref={authorHref}
  authorAvatarUrl={authorAvatarUrl}
  class="reveal group"
  data-ratio={ratio}
  data-index={index}
/>
