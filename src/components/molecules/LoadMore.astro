---
import type { Page } from 'astro';
import MetaLabel from '../atoms/MetaLabel.astro';

// 「もっと読み込む」。素の状態では次ページへのリンクとして働き(JS 無効でも
// たどれる)、JS があれば gallery.ts がクリックを横取りして次ページのカードを
// このページの末尾へ継ぎ足す(全画面リロードなし)。最終ページでは出さない。
interface Props {
  page: Page;
}
const { page } = Astro.props;
---

{
  page.url.next && (
    <div class="flex justify-center py-16">
      <a id="load-more" href={page.url.next} data-next={page.url.next} class="load-more">
        <MetaLabel class="load-more-label">Read More</MetaLabel>
        <svg
          class="load-more-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 5v14M5 12l7 7 7-7" />
        </svg>
      </a>
    </div>
  )
}

<style>
  .load-more {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background-color: var(--color-card);
    border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    border-radius: 999px;
    padding: 0.75rem 1.75rem;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.25s ease;
  }

  /* MetaLabel(子コンポーネント)のspanは LoadMore 側のスコープIDを持たない
     ため、通常のクラスセレクタでは当たらない。:global() で確実に届かせる。 */
  :global(.load-more-label) {
    color: var(--color-ink);
    transition: color 0.25s ease;
  }

  .load-more-icon {
    width: 0.85rem;
    height: 0.85rem;
    color: var(--color-accent);
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* AreaNav のタイルホバーと同じ「差し色をうっすら混ぜて浮き上がらせる」言語で揃える */
  .load-more:hover,
  .load-more:focus-visible {
    background-color: color-mix(in srgb, var(--color-accent) 16%, var(--color-card));
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px color-mix(in srgb, var(--color-ink) 15%, transparent);
  }

  .load-more:hover :global(.load-more-label),
  .load-more:focus-visible :global(.load-more-label) {
    color: var(--color-accent-hover);
  }

  .load-more:hover .load-more-icon,
  .load-more:focus-visible .load-more-icon {
    transform: translateY(2px);
  }

  /* 読み込み中はもう一度押せないようにし、進行中であることを示す */
  .load-more[aria-busy='true'] {
    opacity: 0.5;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .load-more,
    .load-more-icon {
      transition: none;
    }
  }
</style>
