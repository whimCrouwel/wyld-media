---
import MetaLabel from '../atoms/MetaLabel.astro';
import type { Crumb } from '../../lib/schema';

export interface Props {
  crumbs: Crumb[];
  class?: string;
}
const { crumbs, class: className } = Astro.props;
---
{/* relative z-20: プロフィールページ(writers/providers)ではカバー画像に
    -mt-14 z-10 で重ねるアバターがこの直後に続く。パンくずが static のままだと
    アバターの下に沈んで読めなくなるため、常にそれより上に来るよう固定しておく。 */}
<nav aria-label="Breadcrumb" class:list={['relative z-20', className]}>
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {crumbs.map((crumb, i) => {
      const isLast = i === crumbs.length - 1;
      return (
        <li class="flex items-center gap-x-2">
          {isLast ? (
            <MetaLabel aria-current="page">{crumb.name}</MetaLabel>
          ) : (
            <a href={crumb.url} class="transition-opacity hover:opacity-60">
              <MetaLabel class="text-ink">{crumb.name}</MetaLabel>
            </a>
          )}
          {!isLast && <MetaLabel aria-hidden="true">/</MetaLabel>}
        </li>
      );
    })}
  </ol>
</nav>
