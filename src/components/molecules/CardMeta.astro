---
import MetaLabel from '../atoms/MetaLabel.astro';
import WriterAvatar from '../atoms/WriterAvatar.astro';

// ギャラリーカードと Featured 帯で同じメタ行を2箇所に複製していたのを1つに集約。
// 標本カードの体裁: カタログ番号+日付のeyebrow、明朝の見出しタイトル、
// 丸アバター付きの著者行。
interface Props {
  href: string;
  title: string;
  date: string;
  number: number;
  authorName: string;
  authorHref: string;
  authorAvatarUrl: string | null;
}
const { href, title, date, number, authorName, authorHref, authorAvatarUrl } = Astro.props;
---

<div class="card-meta">
  <div class="flex items-baseline justify-between gap-3">
    <MetaLabel class="shrink-0 tabular-nums">No. {String(number).padStart(2, '0')}</MetaLabel>
    <MetaLabel class="shrink-0 tabular-nums">{date}</MetaLabel>
  </div>

  <a href={href} class="card-title-link">
    <h3 class="card-title">{title}</h3>
  </a>

  <a href={authorHref} class="card-author">
    <WriterAvatar src={authorAvatarUrl} name={authorName} size={26} />
    <MetaLabel class="hover:text-ink block truncate transition-colors">{authorName}</MetaLabel>
  </a>
</div>

<style>
  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* タイトルはカードの主役。他のメタ(11px)から一段昇格させて明朝で見せる。
     行は2行までに抑え、溢れは省略する(カード高さを揃えるため)。 */
  .card-title {
    font-family: var(--font-heading);
    font-size: 16px;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-title-link {
    transition: opacity 0.2s ease;
  }

  .card-title-link:hover {
    opacity: 0.6;
  }

  .card-author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    transition: opacity 0.2s ease;
  }

  .card-author:hover {
    opacity: 0.7;
  }
</style>
