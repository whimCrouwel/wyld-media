---
import MetaLabel from '../atoms/MetaLabel.astro';
---
<button type="button" id="search-open" class="search-trigger">
  <MetaLabel>記事を検索</MetaLabel>
</button>

<style>
  /* 紙色で塗るのは、サイドバーのパネル(地図の「海」)の上に置いたとき、
     枠線だけだと地色と明度が近くて欄が消えるため。地図のタイル(陸)と
     同じ紙色にすることで、押せるものの面が1種類に揃う。 */
  .search-trigger {
    width: 100%;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.6rem 1rem;
    text-align: left;
    cursor: pointer;
    background-color: var(--color-bg);
    transition: border-color 0.2s ease;
  }

  .search-trigger:hover,
  .search-trigger:focus-visible {
    border-color: var(--color-meta);
  }
</style>
