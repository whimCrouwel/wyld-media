---
interface Props {
  src: string | null;
  name: string;
  size?: number;
}
const { src, name, size = 64 } = Astro.props;
---

{/* 角丸スクエアのサムネイル。顔写真がない場合は細い罫線の角丸スクエアに名前の頭文字 */}
<span
  class="rounded-card block shrink-0 overflow-hidden"
  style={`width: ${size}px; height: ${size}px;`}
>
  {
    src ? (
      <img
        src={src}
        alt={name}
        width={size}
        height={size}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover"
      />
    ) : (
      <span
        class="bg-card border-hairline text-meta rounded-card flex h-full w-full items-center justify-center border"
        style={`font-family: var(--font-heading); font-size: ${Math.round(size * 0.4)}px;`}
      >
        {name.trim().charAt(0)}
      </span>
    )
  }
</span>
