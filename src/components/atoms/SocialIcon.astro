---
import type { SocialPlatform } from '../../lib/social-links';

interface Props {
  platform: SocialPlatform;
  class?: string;
}
const { platform, class: className = 'h-[18px] w-[18px]' } = Astro.props;
---

{
  /* ボタン自体が丸い黒地なので、アイコン側に外枠(rect/circle)は持たせず、
     地紋(currentColor = 白)で塗る意匠だけにしている。 */
}
{
  platform === 'x' && (
    <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
    </svg>
  )
}
{
  platform === 'instagram' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  /* note.com の公式ロゴ(ペン先モチーフ)そのものではなく、他プラットフォーム
     と統一感を持たせた「頭文字モノグラム」。厳密なロゴ再現ではない点に注意。 */
}
{
  platform === 'note' && (
    <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
      <text x="12" y="17" text-anchor="middle" font-size="15" font-weight="700" font-family="Georgia, serif">
        n
      </text>
    </svg>
  )
}
{
  platform === 'facebook' && (
    <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
      <text x="12" y="18" text-anchor="middle" font-size="17" font-weight="700" font-family="Georgia, serif">
        f
      </text>
    </svg>
  )
}
{
  platform === 'youtube' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
      <path d="M10 9.2v5.6l5-2.8z" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  platform === 'tiktok' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
      <path d="M14 4v10.8a3.3 3.3 0 1 1-3.3-3.3c.4 0 .8.05 1.15.16" />
      <path d="M14 4c.45 2.15 2.1 3.6 4.2 3.85" />
    </svg>
  )
}
{
  platform === 'threads' && (
    <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
      <text x="12" y="17.5" text-anchor="middle" font-size="16" font-weight="700" font-family="sans-serif">
        @
      </text>
    </svg>
  )
}
{
  platform === 'linkedin' && (
    <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
      <text x="12" y="16.5" text-anchor="middle" font-size="11" font-weight="700" font-family="sans-serif" letter-spacing="-1">
        in
      </text>
    </svg>
  )
}
