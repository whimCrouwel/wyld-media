# scripts/backup.env にコピーして値を入れる(backup.env は gitignore 済み)。
# 値はすべて PRODUCTION-SECRETS.local.md にある。

# Supabase 本番の接続文字列。直接接続(db.<ref>.supabase.co)は IPv6 のみで届かないことが
# あるので、Dashboard → Connect → Session pooler の URL(IPv4)を使う:
# postgresql://postgres.<project-ref>:<DBパスワード>@aws-1-<region>.pooler.supabase.com:5432/postgres
DB_URL=""

# Cloudflare R2(PRODUCTION-SECRETS.local.md の「Cloudflare R2」セクション)
R2_BUCKET=""
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
