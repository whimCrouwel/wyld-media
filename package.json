{
  "name": "wild-media",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "admin",
    "packages/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "dev:all": "concurrently -k -n site,admin,fn -c blue,magenta,green \"astro dev\" \"npm run dev -w admin\" \"npm run dev:fn\"",
    "dev:fn": "supabase functions serve --env-file supabase/functions/.env",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run --passWithNoTests",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/shippori-mincho-b1": "^5.2.8",
    "@fontsource/sora": "^5.3.0",
    "@fontsource/yeseva-one": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.2.7",
    "@supabase/supabase-js": "^2.45.0",
    "@tailwindcss/vite": "^4.3.2",
    "@wild-media/blocks-renderer": "^0.1.0",
    "astro": "^5.0.0",
    "embla-carousel": "^8.6.0",
    "lenis": "^1.3.25",
    "probe-image-size": "^7.3.0",
    "tailwindcss": "^4.3.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/probe-image-size": "^7.2.5",
    "@types/three": "^0.185.1",
    "concurrently": "^10.0.3",
    "dotenv": "^16.4.0",
    "vitest": "^2.1.0"
  }
}
